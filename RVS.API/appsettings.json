{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Intake": {
    "BaseUrl": "https://rvintake.com",
    "RedirectBaseUrl": "https://go.rvintake.com"
  },
  "ManagerApp": {
    "BaseUrl": "https://manager.rvintake.com"
  },
  "Nhtsa": {
    "BaseUrl": "https://vpic.nhtsa.dot.gov/api/"
  },
  "AzureCommunicationServices": {
    "Email": {
      "SenderDisplayName": "RV Intake"
    },
    "Sms": {
      "Enabled": false,
      "MaxMessagesPerTenantPerHour": 100
    }
  },
  "PacketEmail": {
    "RetryBaseDelay": "00:00:02",
    "MaxRequestBytes": 9500000
  },
  "Ai": {
    "MaxImageBytes": 5242880,
    "MaxAudioBytes": 10485760,
    "AllowedImageTypes": [ "image/jpeg", "image/png", "image/webp" ],
    "AllowedAudioTypes": [ "audio/webm", "audio/wav", "audio/mp4" ]
  }
}
