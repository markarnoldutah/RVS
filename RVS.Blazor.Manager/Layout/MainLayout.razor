@inherits LayoutComponentBase
@implements IDisposable
@inject RVS.Blazor.Manager.State.ManagerAppState AppState
@inject ThemeService ThemeService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject RVS.UI.Shared.Services.TenantAccessState TenantAccess
@inject NavigationManager Navigation

<MudThemeProvider Theme="ThemeService.CurrentTheme" IsDarkMode="ThemeService.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<KeepSignedInPrompt />

<MudLayout Style="@GetLayoutStyle()">
    @* No Color= : the app bar takes AppbarBackground (Ink) from the theme. Color="Color.Primary"
       would paint it Rust, which the brand reserves for action, not structure (Spec THEME-1). *@
    <MudAppBar Elevation="2">
        @if (_isAuthorized)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           aria-label="Toggle navigation menu"
                           OnClick="ToggleDrawer" />
        }
        <MudLink Href="/" aria-label="RVS Manager home" Class="d-flex align-center ml-1">
            <BrandWordmark Variant="BrandWordmarkVariant.Icon" Reversed="true" Height="30px" Title="RV Intake" />
        </MudLink>
        @* AppbarText carries the colour now — Ink chrome in light and dark, black in high
           contrast — so this no longer hard-codes white/black against a Primary-tinted bar. *@
        <MudText Typo="Typo.h6" Class="ml-3">
            RVS Manager
        </MudText>
        <MudSpacer />
        @if (_isAuthorized)
        {
            <LoginDisplay />
        }
        <MudIconButton Icon="@GetThemeIcon()"
                       Color="Color.Inherit"
                       aria-label="@GetThemeAriaLabel()"
                       OnClick="CycleThemeAsync" />
    </MudAppBar>

    @if (_isAuthorized && !IsRestricted)
    {
        <MudDrawer @bind-Open="_drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Always"
                   Style="@(ThemeService.IsDarkMode ? "color: white;" : "")">
            <NavMenu />
        </MudDrawer>
    }

    <MudMainContent Style="@GetMainContentStyle()">
        @if (_isAuthorized && IsRestricted)
        {
            <TenantAccessRestricted />
        }
        else if (_isAuthorized)
        {
            <MudContainer MaxWidth="MaxWidth.Large" Class="py-4 px-4">
                <ErrorBoundary>
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent Context="ex">
                        <MudAlert Severity="Severity.Error" Class="my-4">@ex.Message</MudAlert>
                    </ErrorContent>
                </ErrorBoundary>
            </MudContainer>
        }
        else
        {
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="ex">
                    <MudAlert Severity="Severity.Error" Class="my-4">@ex.Message</MudAlert>
                </ErrorContent>
            </ErrorBoundary>
        }
    </MudMainContent>

</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool _drawerOpen = true;
    private bool _isAuthorized;

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += StateHasChanged;
        TenantAccess.Changed += OnTenantAccessChanged;
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await UpdateAuthorizedAsync(AuthenticationStateTask);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AppState.InitializeAsync();
            await ThemeService.InitializeAsync();
        }
    }

    // Issue #625: once the API reports the tenant disabled, every page is replaced by one
    // "access restricted" message. The authentication/* pages stay reachable so sign-out and
    // sign-in still work.
    private bool IsRestricted =>
        TenantAccess.IsRestricted
        && !Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("authentication/", StringComparison.OrdinalIgnoreCase);

    private void OnTenantAccessChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(() => UpdateAuthorizedAsync(task));
    }

    private async Task UpdateAuthorizedAsync(Task<AuthenticationState>? task)
    {
        if (task is null) return;
        var state = await task;
        var authorized = state.User.Identity?.IsAuthenticated == true;
        if (authorized != _isAuthorized)
        {
            _isAuthorized = authorized;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= StateHasChanged;
        TenantAccess.Changed -= OnTenantAccessChanged;
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private Task CycleThemeAsync()
    {
        var next = ThemeService.Mode switch
        {
            ThemeMode.Light => ThemeMode.Dark,
            ThemeMode.Dark => ThemeMode.HighContrast,
            _ => ThemeMode.Light
        };
        return ThemeService.SetModeAsync(next);
    }

    private string GetThemeIcon() => ThemeService.Mode switch
    {
        ThemeMode.Light => Icons.Material.Filled.LightMode,
        ThemeMode.Dark => Icons.Material.Filled.DarkMode,
        ThemeMode.HighContrast => Icons.Material.Filled.Contrast,
        _ => Icons.Material.Filled.LightMode
    };

    private string GetThemeAriaLabel() => ThemeService.Mode switch
    {
        ThemeMode.Light => "Switch to dark theme",
        ThemeMode.Dark => "Switch to high contrast theme",
        ThemeMode.HighContrast => "Switch to light theme",
        _ => "Switch theme"
    };

    private string GetMainContentStyle()
    {
        return _isAuthorized
            ? string.Empty
            : "min-height: calc(100vh - var(--mud-appbar-height));";
    }

    private string GetLayoutStyle()
    {
        return _isAuthorized
            ? string.Empty
            : "background: url('images/tetons-desktop.jpg') center 40%/cover no-repeat fixed; min-height: 100vh;";
    }
}