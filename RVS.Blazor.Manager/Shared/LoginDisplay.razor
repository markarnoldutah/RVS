@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using RVS.UI.Shared.Services
@inject NavigationManager Navigation
@inject ThemeService ThemeService

<AuthorizeView Context="authState">
    <Authorized>
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <ActivatorContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2"
                           Style="cursor: pointer;" @onclick="context.ToggleAsync">
                    <MudText Typo="Typo.body2" Color="Color.Inherit">
                        @GetFirstName(authState)
                    </MudText>
                    <MudAvatar Color="Color.Secondary" Size="Size.Small"
                               aria-label="@GetDisplayName(authState)">
                        @GetUserInitials(authState)
                    </MudAvatar>
                </MudStack>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Disabled="true">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle2" Style="@($"color: {MenuItemTextColor}")">@GetDisplayName(authState)</MudText>
                        <MudText Typo="Typo.caption" Style="@($"color: {MenuItemTextColor}")">@GetUserEmail(authState)</MudText>
                    </MudStack>
                </MudMenuItem>
                <MudDivider />
                <div class="px-4 py-2">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.subtitle2" Style="@($"color: {MenuItemTextColor}")">Theme</MudText>
                        <MudRadioGroup T="ThemeMode" Value="ThemeService.Mode" ValueChanged="OnThemeModeChangedAsync">
                            <MudStack Spacing="0">
                                <MudRadio T="ThemeMode" Value="ThemeMode.Light" Dense="true" Size="Size.Small" Color="Color.Primary" Style="font-size: 0.75rem;">Light</MudRadio>
                                <MudRadio T="ThemeMode" Value="ThemeMode.Dark" Dense="true" Size="Size.Small" Color="Color.Primary" Style="font-size: 0.75rem;">Dark</MudRadio>
                                <MudRadio T="ThemeMode" Value="ThemeMode.HighContrast" Dense="true" Size="Size.Small" Color="Color.Primary" Style="font-size: 0.75rem;">High Contrast</MudRadio>
                            </MudStack>
                        </MudRadioGroup>
                    </MudStack>
                </div>
                <MudDivider />
                <div class="px-4 py-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="BeginLogout">
                        Log Out
                    </MudButton>
                </div>
            </ChildContent>
        </MudMenu>
    </Authorized>
    <NotAuthorized>
        <MudButton Variant="Variant.Text" Color="Color.Inherit"
                   OnClick="BeginLogin">
            Log in
        </MudButton>
    </NotAuthorized>
</AuthorizeView>

@code {
    /// <summary>
    /// Manual "Log in" button. Builds an explicit <see cref="InteractiveRequestOptions"/> so this
    /// always goes straight to a full-page redirect — never the library's silent/iframe check —
    /// which is what makes it safe to attach <c>prompt=login</c> here per
    /// <see cref="KeepSignedInPolicy"/>. See that type's doc comment for why this must never be
    /// set on the provider's global options instead.
    /// </summary>
    private async Task BeginLogin()
    {
        var requestOptions = new InteractiveRequestOptions { Interaction = InteractionType.SignIn, ReturnUrl = Navigation.Uri };

        string? preference = null;
        try
        {
            preference = await JS.InvokeAsync<string?>("rvsSession_getPersistPreference");
        }
        catch (JSException)
        {
            // session-persist.js missing or storage blocked — ShouldForceLogin fails closed on null.
        }

        if (KeepSignedInPolicy.ShouldForceLogin(preference))
        {
            requestOptions.TryAddAdditionalParameter(KeepSignedInPolicy.PromptParameter, KeepSignedInPolicy.PromptLoginValue);
        }

        Navigation.NavigateToLogin("authentication/login", requestOptions);
    }

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    [Inject]
    private IConfiguration Configuration { get; set; } = default!;

    [Inject]
    private RVS.UI.Shared.Services.RefreshTokenRevocationClient RevocationClient { get; set; } = default!;

    private async Task BeginLogout()
    {
        // Revoke the refresh token at Auth0 and drop the persisted sign-in before the framework's
        // own sign-out (issue #498), so a token copied earlier stops working. Best effort: a
        // failed revoke never blocks signing out.
        try
        {
            var refreshToken = await JS.InvokeAsync<string?>("rvsAuth_getRefreshToken", Configuration["Auth0:ClientId"]);
            await RevocationClient.RevokeAsync(refreshToken);
            await JS.InvokeVoidAsync("rvsSession_clearPersisted");
        }
        catch (JSException)
        {
            // Interop unavailable — the framework sign-out below still removes the user record,
            // which also clears the mirror.
        }

        Navigation.NavigateToLogout("authentication/logout");
    }

    private string MenuItemTextColor => ThemeService.Mode switch
    {
        ThemeMode.Dark => "#FFFFFF",
        ThemeMode.HighContrast => "#FFFF00",
        _ => "var(--mud-palette-primary)"
    };

    private async Task OnThemeModeChangedAsync(ThemeMode mode)
    {
        await ThemeService.SetModeAsync(mode);
    }

    private static string GetFirstName(AuthenticationState authState)
    {
        var givenName = authState.User.FindFirst("given_name")?.Value;
        if (!string.IsNullOrWhiteSpace(givenName))
        {
            return givenName;
        }

        var fullName = GetDisplayName(authState);
        var nameParts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return nameParts.Length > 0 ? nameParts[0] : "User";
    }

    private static string GetDisplayName(AuthenticationState authState)
    {
        return authState.User.Identity?.Name
            ?? authState.User.FindFirst("email")?.Value
            ?? authState.User.FindFirst("preferred_username")?.Value
            ?? "User";
    }

    private static string GetUserInitials(AuthenticationState authState)
    {
        var fullName = GetDisplayName(authState);
        var nameParts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (nameParts.Length >= 2)
        {
            return $"{nameParts[0][0]}{nameParts[^1][0]}".ToUpper();
        }

        if (nameParts.Length == 1 && nameParts[0].Length > 0)
        {
            return nameParts[0][..Math.Min(2, nameParts[0].Length)].ToUpper();
        }

        return "U";
    }

    private static string GetUserEmail(AuthenticationState authState)
    {
        return authState.User.FindFirst("email")?.Value
            ?? authState.User.FindFirst("preferred_username")?.Value
            ?? authState.User.FindFirst("upn")?.Value
            ?? string.Empty;
    }
}
