@inject NavigationManager Navigation
@inject ThemeService ThemeService

<AuthorizeView Context="authState">
    <Authorized>
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" OpenChanged="OnMenuOpenChangedAsync">
            <ActivatorContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2"
                           Style="cursor: pointer;" @onclick="context.ToggleAsync">
                    <MudText Typo="Typo.body2" Color="Color.Inherit">
                        @GetFirstName(authState)
                    </MudText>
                    <MudAvatar Color="Color.Secondary" Size="Size.Small"
                               aria-label="@GetDisplayName(authState)">
                        @GetUserInitials(authState)
                    </MudAvatar>
                </MudStack>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Disabled="true">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle2" Style="@($"color: {MenuItemTextColor}")">@GetDisplayName(authState)</MudText>
                        <MudText Typo="Typo.caption" Style="@($"color: {MenuItemTextColor}")">@GetUserEmail(authState)</MudText>
                    </MudStack>
                </MudMenuItem>
                <MudDivider />
                <div class="px-4 py-2">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.subtitle2" Style="@($"color: {MenuItemTextColor}")">Theme</MudText>
                        <MudRadioGroup T="ThemeMode" Value="ThemeService.Mode" ValueChanged="OnThemeModeChangedAsync">
                            <MudStack Spacing="0">
                                <MudRadio T="ThemeMode" Value="ThemeMode.Light" Dense="true" Size="Size.Small" Color="Color.Primary" Style="font-size: 0.75rem;">Light</MudRadio>
                                <MudRadio T="ThemeMode" Value="ThemeMode.Dark" Dense="true" Size="Size.Small" Color="Color.Primary" Style="font-size: 0.75rem;">Dark</MudRadio>
                                <MudRadio T="ThemeMode" Value="ThemeMode.HighContrast" Dense="true" Size="Size.Small" Color="Color.Primary" Style="font-size: 0.75rem;">High Contrast</MudRadio>
                            </MudStack>
                        </MudRadioGroup>
                    </MudStack>
                </div>
                <MudDivider />
                @* Change this device's "Keep me signed in" answer (issue #616). The saved sign-in is
                   added or removed at once; the current tab stays signed in either way. Whether Auth0
                   asks for the password is decided when the app starts (KeepSignedInPolicy,
                   Program.cs), so the rest applies from the next app load.

                   Trimmed in #703: the radios already say which answer is stored, so the "Currently:"
                   line and the "Ask me again at next sign-in" reset are gone — re-asking is the same
                   decision the radios make, spelled out twice. The shared-computer warning stays, but
                   only on the answer it warns about. *@
                <div class="px-4 py-2" style="max-width: 280px;">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.subtitle2" Style="@($"color: {MenuItemTextColor}")">Keep me signed in on this device</MudText>
                        @if (_keepSignedIn is { } keepSignedIn)
                        {
                            <MudRadioGroup T="KeepSignedInState" Value="keepSignedIn" ValueChanged="OnKeepSignedInChangedAsync">
                                <MudStack Spacing="0">
                                    <MudRadio T="KeepSignedInState" Value="KeepSignedInState.On" Dense="true" Size="Size.Small" Color="Color.Primary" Style="font-size: 0.75rem;">On</MudRadio>
                                    <MudRadio T="KeepSignedInState" Value="KeepSignedInState.Off" Dense="true" Size="Size.Small" Color="Color.Primary" Style="font-size: 0.75rem;">Off</MudRadio>
                                </MudStack>
                            </MudRadioGroup>
                            @if (keepSignedIn == KeepSignedInState.On)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Warning">
                                    @KeepSignedInPolicy.SharedComputerWarning
                                </MudText>
                            }
                            <MudText Typo="Typo.caption">Applies next time you open the app.</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption">Not available in this browser.</MudText>
                        }
                    </MudStack>
                </div>
                <MudDivider />
                <div class="px-4 py-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="BeginLogout">
                        Log Out
                    </MudButton>
                </div>
            </ChildContent>
        </MudMenu>
    </Authorized>
    <NotAuthorized>
        <MudButton Variant="Variant.Text" Color="Color.Inherit"
                   OnClick="BeginLogin">
            Log in
        </MudButton>
    </NotAuthorized>
</AuthorizeView>

@code {
    private void BeginLogin()
    {
        Navigation.NavigateToLogin("authentication/login");
    }

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    [Inject]
    private SignOutService SignOut { get; set; } = default!;

    private Task BeginLogout() => SignOut.SignOutAsync();

    // Null until read, or when session-persist.js is unavailable.
    private KeepSignedInState? _keepSignedIn;

    // Re-read on every open: KeepSignedInPrompt may have stored an answer since the last render.
    private async Task OnMenuOpenChangedAsync(bool open)
    {
        if (open)
        {
            await RefreshKeepSignedInAsync();
        }
    }

    private async Task RefreshKeepSignedInAsync()
    {
        try
        {
            _keepSignedIn = KeepSignedInPolicy.ParseState(await JS.InvokeAsync<string?>("rvsSession_getPersistPreference"));
        }
        catch (JSException)
        {
            _keepSignedIn = null;
        }
    }

    private async Task OnKeepSignedInChangedAsync(KeepSignedInState state)
    {
        await JS.InvokeVoidAsync("rvsSession_setPersist", KeepSignedInPolicy.ToPersist(state));
        await RefreshKeepSignedInAsync();
    }

    private string MenuItemTextColor => ThemeService.Mode switch
    {
        ThemeMode.Dark => "#FFFFFF",
        ThemeMode.HighContrast => "#FFFF00",
        _ => "var(--mud-palette-primary)"
    };

    private async Task OnThemeModeChangedAsync(ThemeMode mode)
    {
        await ThemeService.SetModeAsync(mode);
    }

    private static string GetFirstName(AuthenticationState authState)
    {
        var givenName = authState.User.FindFirst("given_name")?.Value;
        if (!string.IsNullOrWhiteSpace(givenName))
        {
            return givenName;
        }

        var fullName = GetDisplayName(authState);
        var nameParts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return nameParts.Length > 0 ? nameParts[0] : "User";
    }

    private static string GetDisplayName(AuthenticationState authState)
    {
        return authState.User.Identity?.Name
            ?? authState.User.FindFirst("email")?.Value
            ?? authState.User.FindFirst("preferred_username")?.Value
            ?? "User";
    }

    private static string GetUserInitials(AuthenticationState authState)
    {
        var fullName = GetDisplayName(authState);
        var nameParts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (nameParts.Length >= 2)
        {
            return $"{nameParts[0][0]}{nameParts[^1][0]}".ToUpper();
        }

        if (nameParts.Length == 1 && nameParts[0].Length > 0)
        {
            return nameParts[0][..Math.Min(2, nameParts[0].Length)].ToUpper();
        }

        return "U";
    }

    private static string GetUserEmail(AuthenticationState authState)
    {
        return authState.User.FindFirst("email")?.Value
            ?? authState.User.FindFirst("preferred_username")?.Value
            ?? authState.User.FindFirst("upn")?.Value
            ?? string.Empty;
    }
}
