@inject IJSRuntime JS
@implements IAsyncDisposable

@* Covers the viewport while authentication resolves. It used to paint the Tetons photo, as
   did index.html's splash and the unauthenticated layout, and a cover-scaled hero re-scaled
   and flashed at every handover between them (#703). All three now use the app's own ground,
   which here means the active MudTheme — so this follows light, dark and high contrast
   without naming a colour, and only the content changes as the state does. *@
<div class="auth-state-panel">
    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="0">
        @* Typo + MudBlazor spacing only — no sizes or weights of our own. Typo.h5 is already
           Space Grotesk 500 at 1.5rem and Typo.body2 0.875rem (RvsTypography), which is what
           index.html's splash copies so the handover to this panel does not jump. *@
        <MudText Typo="Typo.h5" Class="mb-2">RV Intake Manager</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-6">@Message</MudText>
        @if (!string.IsNullOrEmpty(ErrorDetail))
        {
            @* Filled, not Outlined: an outlined alert is transparent, and Warning's #C98A2C on
               the old photo was unreadable (#703). Filled Error keeps the detail on a solid
               surface with contrast text on every ground this panel can have. *@
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true"
                      Style="margin: 0 0 16px; max-width: 600px; overflow-wrap: anywhere;">
                <MudText Typo="Typo.caption">@ErrorDetail</MudText>
            </MudAlert>
        }
        <div class="auth-progress-track" role="progressbar" aria-label="@Message" aria-hidden="@(!ShowSpinner ? "true" : null)">
            @if (ShowSpinner)
            {
                <div class="auth-progress-bar"></div>
            }
        </div>
        <div style="@GetButtonWrapperStyle()">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                       Href="@(ButtonHref ?? "#")"
                       tabindex="@(string.IsNullOrEmpty(ButtonText) ? "-1" : null)"
                       aria-hidden="@(string.IsNullOrEmpty(ButtonText) ? "true" : null)">
                @(string.IsNullOrEmpty(ButtonText) ? " " : ButtonText)
            </MudButton>
        </div>
    </MudStack>
</div>

@code {
    [Parameter, EditorRequired] public string Message { get; set; } = string.Empty;
    [Parameter] public bool ShowSpinner { get; set; }
    [Parameter] public string? ButtonText { get; set; }
    [Parameter] public string? ButtonHref { get; set; }
    [Parameter] public string? ErrorDetail { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("rvs_setHtmlOverflow", "hidden");
    }

    public async ValueTask DisposeAsync()
    {
        await JS.InvokeVoidAsync("rvs_setHtmlOverflow", "");
    }

    private string GetButtonWrapperStyle() =>
        string.IsNullOrEmpty(ButtonText)
            ? "margin-top: 24px; visibility: hidden; pointer-events: none;"
            : "margin-top: 24px;";
}
