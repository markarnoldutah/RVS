@page "/locations"
@inject LookupApiClient LookupClient
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject ThemeService ThemeService
@implements IDisposable
@using RVS.UI.Shared.Validation
@using RVS.UI.Shared.Theme
@using RVS.Domain.Branding

<PageTitle>RV Intake Manager — Locations</PageTitle>

<MudStack Spacing="4" Class="pa-2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h4">Locations</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="ShowCreateDialog">
            Add Location
        </MudButton>
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    else
    {
        @* ───────────────────────── Locations table ─────────────────────────
           Single network call returns LocationSummaryResponseDto rows containing
           name, slug, phone, address, and capability badges. We only fetch the
           full LocationDetailDto when a row is clicked (drawer opens).         *@
        <MudTable Items="_summaries"
                  Dense="true"
                  Hover="true"
                  Striped="true"
                  Bordered="false"
                  Elevation="1"
                  OnRowClick="OnRowClickAsync"
                  T="LocationSummaryResponseDto"
                  RowStyle="cursor: pointer;">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Slug</MudTh>
                <MudTh>Phone</MudTh>
                <MudTh>Location</MudTh>
                <MudTh Style="text-align: center;">Capabilities</MudTh>
                <MudTh Style="text-align: right;">Created</MudTh>
                <MudTh Style="text-align: right;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Color="Color.Primary" Size="Size.Small" />
                        <MudText Typo="Typo.body2"><strong>@context.Name</strong></MudText>
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="Slug">
                    <MudText Typo="Typo.body2" Style="font-family: monospace;">@context.Slug</MudText>
                </MudTd>
                <MudTd DataLabel="Phone">@(context.Phone ?? "—")</MudTd>
                <MudTd DataLabel="Location">@FormatCityState(context.Address)</MudTd>
                <MudTd DataLabel="Capabilities" Style="text-align: center;">
                    @if (context.EnabledCapabilities.Count > 0)
                    {
                        <MudBadge Content="@context.EnabledCapabilities.Count"
                                  Color="Color.Primary"
                                  Overlap="false"
                                  Bordered="true">
                            <MudIcon Icon="@Icons.Material.Outlined.Build" Size="Size.Small" />
                        </MudBadge>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">—</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Created" Style="text-align: right;">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @context.CreatedAtUtc.ToLocalTime().ToString("d")
                    </MudText>
                </MudTd>
                <MudTd Style="text-align: right;">
                    <div @onclick:stopPropagation="true">
                        <MudTooltip Text="Send intake link">
                            <MudIconButton Icon="@Icons.Material.Filled.Sms"
                                           Size="Size.Small"
                                           Color="Color.Primary"
                                           aria-label="@($"Send intake link for {context.Name}")"
                                           OnClick="@(() => OpenSendIntakeLink(context))" />
                        </MudTooltip>
                        <MudIconButton Icon="@Icons.Material.Filled.QrCode2"
                                       Size="Size.Small"
                                       aria-label="Download QR code"
                                       OnClick="@(() => DownloadQrCodeAsync(context.LocationId, context.Slug))" />
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4" Color="Color.Secondary">No locations yet — click <strong>Add Location</strong> to create your first one.</MudText>
            </NoRecordsContent>
        </MudTable>
    }

    <SendIntakeLinkDialog @bind-Visible="_sendLinkOpen"
                          LocationId="@_sendLinkLocationId"
                          LocationName="@_sendLinkLocationName" />

    @* Location flyout — follows the service request flyout's shell and form styling (issue #724):
       theme-aware edge and background, sticky header and footer, one card per field with a bold
       label above an outlined input. *@
    <MudDrawer @bind-Open="_dialogOpen"
               Anchor="Anchor.End"
               Variant="@DrawerVariant.Temporary"
               Fixed="true"
               Elevation="0"
               Width="min(640px, 100vw)"
               Overlay="true"
               Style="@FlyoutStyles.DrawerStyle(ThemeService.Mode)">
        <div class="d-flex flex-column" style="@FlyoutStyles.ColumnStyle(ThemeService.Mode)">
            @* Sticky title header *@
            <MudPaper Elevation="0" Square="true" Class="px-4 py-3"
                      Style="@FlyoutStyles.HeaderStyle(ThemeService.Mode)">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="width: 100%;">
                    @if (_editingLocationId is null)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Add" Color="Color.Primary" />
                        <MudText Typo="Typo.h5" Style="font-weight: 600;">New Location</MudText>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" />
                        <MudText Typo="Typo.h5" Style="font-weight: 600;">Edit Location</MudText>
                    }
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   Class="section-icon-btn"
                                   aria-label="Close"
                                   OnClick="CloseDialog" />
                </MudStack>
            </MudPaper>

            @* Scrollable body *@
            <div class="flex-grow-1 px-4 py-4" style="overflow-y: auto;">
                <MudForm @ref="_form2">
                    <MudStack Spacing="4">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.h6" Style="color: var(--mud-palette-text-primary);">Location</MudText>
                            <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">
                                How this location appears to staff and customers
                            </MudText>
                        </MudStack>

                        <MudPaper Elevation="1" Class="pa-4" Style="background: var(--mud-palette-background);">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.body1" Style="font-weight: 700; color: var(--mud-palette-text-primary);">Name</MudText>
                                <MudTextField T="string" @bind-Value="_form.Name"
                                              Validation="@(new Func<string?, string?>(ValidateName))"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Placeholder="e.g., Salt Lake City"
                                              autocomplete="off" />
                            </MudStack>
                        </MudPaper>

                        <MudPaper Elevation="1" Class="pa-4" Style="background: var(--mud-palette-background);">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.body1" Style="font-weight: 700; color: var(--mud-palette-text-primary);">Phone</MudText>
                                <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">Optional — shown on intake landing page</MudText>
                                <MudTextField T="string" @bind-Value="_form.Phone"
                                              InputType="InputType.Telephone"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Placeholder="(555) 123-4567"
                                              autocomplete="tel" />
                            </MudStack>
                        </MudPaper>

                        <MudStack Spacing="1" Class="mt-2">
                            <MudText Typo="Typo.h6" Style="color: var(--mud-palette-text-primary);">Address</MudText>
                        </MudStack>

                        <MudPaper Elevation="1" Class="pa-4" Style="background: var(--mud-palette-background);">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.body1" Style="font-weight: 700; color: var(--mud-palette-text-primary);">Address line 1</MudText>
                                <MudTextField T="string" @bind-Value="_form.Address1"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Placeholder="123 Main St"
                                              autocomplete="address-line1" />
                            </MudStack>
                        </MudPaper>

                        <MudPaper Elevation="1" Class="pa-4" Style="background: var(--mud-palette-background);">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.body1" Style="font-weight: 700; color: var(--mud-palette-text-primary);">Address line 2</MudText>
                                <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">Apartment, suite, or unit (optional)</MudText>
                                <MudTextField T="string" @bind-Value="_form.Address2"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Placeholder="Suite 200"
                                              autocomplete="address-line2" />
                            </MudStack>
                        </MudPaper>

                        <MudPaper Elevation="1" Class="pa-4" Style="background: var(--mud-palette-background);">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="5">
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.body1" Style="font-weight: 700; color: var(--mud-palette-text-primary);">City</MudText>
                                        <MudTextField T="string" @bind-Value="_form.City"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Placeholder="Salt Lake City"
                                                      autocomplete="address-level2" />
                                    </MudStack>
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.body1" Style="font-weight: 700; color: var(--mud-palette-text-primary);">State</MudText>
                                        <MudTextField T="string" @bind-Value="_form.State"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Placeholder="UT"
                                                      autocomplete="address-level1" />
                                    </MudStack>
                                </MudItem>
                                <MudItem xs="6" sm="4">
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.body1" Style="font-weight: 700; color: var(--mud-palette-text-primary);">Postal code</MudText>
                                        <MudTextField T="string" @bind-Value="_form.PostalCode"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Placeholder="84101"
                                                      autocomplete="postal-code" />
                                    </MudStack>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>

                        @* Time zone — follows from the address; drives the packet Received line (issue #506) *@
                        <MudPaper Elevation="1" Class="pa-4" Style="background: var(--mud-palette-background);">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.body1" Style="font-weight: 700; color: var(--mud-palette-text-primary);">Time zone</MudText>
                                <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">
                                    Sets the Received time shown on service packets. Leave blank to show UTC.
                                </MudText>
                                <MudSelect T="string" @bind-Value="_form.TimeZoneId"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Placeholder="UTC"
                                           Clearable="true"
                                           AnchorOrigin="Origin.BottomCenter"
                                           TransformOrigin="Origin.TopCenter">
                                    @foreach (var tz in DealershipTimeZones.All)
                                    {
                                        <MudSelectItem T="string" Value="@tz.IanaId">@tz.DisplayName</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudStack>
                        </MudPaper>

                        @* Capabilities Section *@
                        @if (_tenantCapabilities.Count > 0)
                        {
                            <MudStack Spacing="1" Class="mt-2">
                                <MudText Typo="Typo.h6" Style="color: var(--mud-palette-text-primary);">Service Capabilities</MudText>
                                <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">
                                    Select which services this location offers. Managed at the tenant level in Settings.
                                </MudText>
                            </MudStack>

                            <MudPaper Elevation="1" Class="pa-4" Style="background: var(--mud-palette-background);">
                                <MudStack Spacing="0">
                                    @foreach (var cap in _tenantCapabilities.Where(c => c.IsActive))
                                    {
                                        var code = cap.Code;
                                        <MudCheckBox T="bool"
                                                     Value="@_form.EnabledCapabilities.Contains(code)"
                                                     ValueChanged="@(v => ToggleCapability(code, v))"
                                                     Label="@cap.Name"
                                                     Color="Color.Primary"
                                                     Dense="true" />
                                    }
                                </MudStack>
                            </MudPaper>
                        }

                        @* Service packet email — Spec B-6 / C-6 (issue #447). Defaults work as they
                           come, so the only thing a new location needs here is a recipient. *@
                        <MudStack Spacing="1" Class="mt-2">
                            <MudText Typo="Typo.h6" Style="color: var(--mud-palette-text-primary);">Service Packet Email</MudText>
                            <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">
                                Each new service request is emailed to these addresses as a one-page packet.
                            </MudText>
                        </MudStack>

                        <MudPaper Elevation="1" Class="pa-4" Style="background: var(--mud-palette-background);">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.body1" Style="font-weight: 700; color: var(--mud-palette-text-primary);">Packet email</MudText>
                                <MudSwitch T="bool" @bind-Value="_form.PacketEnabled"
                                           Color="Color.Primary"
                                           Label="@(_form.PacketEnabled ? "Packet email on" : "Packet email off")" />
                            </MudStack>
                        </MudPaper>

                        <MudPaper Elevation="1" Class="pa-4" Style="background: var(--mud-palette-background);">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.body1" Style="font-weight: 700; color: var(--mud-palette-text-primary);">Recipients</MudText>
                                @if (_form.Recipients.Count == 0)
                                {
                                    <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">No recipients yet.</MudText>
                                }
                                @foreach (var recipient in _form.Recipients)
                                {
                                    var address = recipient;
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        <MudText Typo="Typo.body2" Style="word-break: break-all;">@address</MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                       Size="Size.Small"
                                                       Class="section-icon-btn"
                                                       aria-label="@($"Remove {address}")"
                                                       OnClick="@(() => RemoveRecipient(address))" />
                                    </MudStack>
                                }
                                <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                                    <MudTextField T="string" @bind-Value="_newRecipient"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  InputType="InputType.Email"
                                                  Placeholder="service@yourdealership.com"
                                                  Error="@(_recipientError is not null)"
                                                  ErrorText="@_recipientError"
                                                  HelperText="@($"{_form.Recipients.Count} of {MaxRecipients}")"
                                                  Immediate="true"
                                                  OnKeyDown="OnRecipientKeyDown"
                                                  Disabled="@(_form.Recipients.Count >= MaxRecipients)"
                                                  aria-label="Add recipient email"
                                                  autocomplete="off" />
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                               Class="mt-1"
                                               StartIcon="@Icons.Material.Filled.Add"
                                               OnClick="@(() => AddRecipient())"
                                               Disabled="@(_form.Recipients.Count >= MaxRecipients)">
                                        Add
                                    </MudButton>
                                </MudStack>

                                @if (_packetError is not null)
                                {
                                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_packetError</MudAlert>
                                }
                            </MudStack>
                        </MudPaper>

                        <MudPaper Elevation="1" Class="pa-4" Style="background: var(--mud-palette-background);">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.body1" Style="font-weight: 700; color: var(--mud-palette-text-primary);">Attachments</MudText>
                                <MudCheckBox T="bool" @bind-Value="_form.AttachPdf"
                                             Label="Attach the packet as a PDF"
                                             Color="Color.Primary"
                                             Dense="true" />
                                <MudCheckBox T="bool" @bind-Value="_form.IncludePhotos"
                                             Label="Attach the customer's original photos"
                                             Color="Color.Primary"
                                             Dense="true" />
                            </MudStack>
                        </MudPaper>

                        <MudExpansionPanels Elevation="1" Dense="true">
                            <MudExpansionPanel Text="More packet options" Dense="true"
                                               Style="background: var(--mud-palette-background);">
                                <MudStack Spacing="4">
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.body1" Style="font-weight: 700; color: var(--mud-palette-text-primary);">Paste block length (characters)</MudText>
                                        <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">
                                            Longest the DMS paste block may be. @MinPasteBlockCharacterCap–@MaxPasteBlockCharacterCap.
                                        </MudText>
                                        <MudNumericField T="int" @bind-Value="_form.PasteBlockCharacterCap"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         InputMode="InputMode.numeric"
                                                         Min="MinPasteBlockCharacterCap"
                                                         Max="MaxPasteBlockCharacterCap" />
                                    </MudStack>
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.body1" Style="font-weight: 700; color: var(--mud-palette-text-primary);">Customer status link lasts (days)</MudText>
                                        <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">1–@MaxStatusLinkTtlDays days.</MudText>
                                        <MudNumericField T="int" @bind-Value="_form.StatusLinkTtlDays"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         InputMode="InputMode.numeric"
                                                         Min="1"
                                                         Max="MaxStatusLinkTtlDays" />
                                    </MudStack>
                                </MudStack>
                            </MudExpansionPanel>
                        </MudExpansionPanels>

                        @* Customer-facing branding — Spec A-16 (issue #470). Both fields are optional and
                           fall back to RV Intake's own look independently. *@
                        <MudStack Spacing="1" Class="mt-2">
                            <MudText Typo="Typo.h6" Style="color: var(--mud-palette-text-primary);">Branding</MudText>
                            <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">
                                What customers see on this location's intake form and at the top of its packets.
                                Leave blank to use RV Intake's.
                            </MudText>
                        </MudStack>

                        <MudPaper Elevation="1" Class="pa-4" Style="background: var(--mud-palette-background);">
                            <MudStack Spacing="4">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.body1" Style="font-weight: 700; color: var(--mud-palette-text-primary);">Logo URL</MudText>
                                    <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">
                                        A PNG or JPEG at an https:// address — the one on your website works.
                                        Use a transparent background, in a version that reads on your header colour:
                                        it sits straight on that colour, and on a white panel only when no colour is set.
                                    </MudText>
                                    <MudTextField T="string" @bind-Value="_form.LogoUrl"
                                                  Validation="@(new Func<string?, string?>(ValidateLogoUrl))"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  InputType="InputType.Url"
                                                  Immediate="true"
                                                  Clearable="true"
                                                  Placeholder="https://yourdealership.com/logo.png"
                                                  autocomplete="off" />
                                </MudStack>
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.body1" Style="font-weight: 700; color: var(--mud-palette-text-primary);">Header colour</MudText>
                                    <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">
                                        The bar across the top of the intake form. Leave blank for RV Intake's blue.
                                    </MudText>
                                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                                        <MudTextField T="string" @bind-Value="_form.HeaderColor"
                                                      Validation="@(new Func<string?, string?>(ValidateHeaderColor))"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Immediate="true"
                                                      Clearable="true"
                                                      Placeholder="@RvsBrand.Ink"
                                                      autocomplete="off" />
                                        <input type="color" class="header-color-picker"
                                               value="@HeaderPickerValue"
                                               @onchange="OnHeaderColorPicked"
                                               aria-label="Pick a header colour" />
                                    </MudStack>
                                </MudStack>
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.body1" Style="font-weight: 700; color: var(--mud-palette-text-primary);">Accent colour</MudText>
                                    <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">
                                        Buttons, links and highlighted fields on the intake form. Leave blank for RV Intake's rust.
                                        It is also used as link text on white, so a colour too light to read there is shown to
                                        customers a little darker — the preview shows exactly what they'll see.
                                    </MudText>
                                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                                        <MudTextField T="string" @bind-Value="_form.AccentColor"
                                                      Validation="@(new Func<string?, string?>(ValidateAccentColor))"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Immediate="true"
                                                      Clearable="true"
                                                      Placeholder="@RvsBrand.Accent"
                                                      autocomplete="off" />
                                        <input type="color" class="header-color-picker"
                                               value="@AccentPickerValue"
                                               @onchange="OnAccentColorPicked"
                                               aria-label="Pick an accent colour" />
                                    </MudStack>
                                    @if (AccentAdjusted)
                                    {
                                        <MudAlert Severity="Severity.Info" Dense="true">
                                            @HeaderColor.Normalize(_form.AccentColor) is too light for link text on white, so customers
                                            will see the darker shade @AccentPreviewColor.
                                        </MudAlert>
                                    }
                                </MudStack>
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.body1" Style="font-weight: 700; color: var(--mud-palette-text-primary);">Preview</MudText>
                                    <div class="header-preview" style="@HeaderPreviewStyle" aria-hidden="true">
                                        @if (LocationBrandingValidator.IsHttpsUrl(_form.LogoUrl))
                                        {
                                            <span class="@HeaderPreviewLogoClass"><img src="@_form.LogoUrl!.Trim()" alt="" /></span>
                                        }
                                        else
                                        {
                                            <BrandWordmark Reversed="@HeaderPreviewReversed" Height="28px" Title="" />
                                        }
                                    </div>
                                    @* The intake page under the bar: a button and a link in the accent. *@
                                    <div class="accent-preview" aria-hidden="true">
                                        <span class="accent-preview-button" style="@AccentPreviewButtonStyle">Continue</span>
                                        <span class="accent-preview-link" style="@AccentPreviewLinkStyle">Privacy policy</span>
                                    </div>
                                </MudStack>
                            </MudStack>
                        </MudPaper>
                    </MudStack>
                </MudForm>
            </div>

            @* Sticky footer *@
            <MudPaper Elevation="0" Square="true" Class="pa-3"
                      Style="@FlyoutStyles.FooterStyle(ThemeService.Mode)">
                <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                    <MudButton OnClick="CloseDialog">Cancel</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveLocationAsync" Disabled="_saving">
                        @if (_saving)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Save location
                    </MudButton>
                </MudStack>
            </MudPaper>
        </div>
    </MudDrawer>
</MudStack>

@code {
    // ──────────────────────────────────────────────────────────────────────────
    //  Recommended additional metadata that should be editable per location
    //  (placeholder — left for a future change as called out in the issue):
    //   • Service capabilities (already supported via checkboxes below)
    //   • Intake form configuration:
    //       – AllowAnonymousIntake (toggle)
    //       – MaxFileSizeMb / MaxAttachments (numeric inputs)
    //       – AcceptedFileTypes (chip-list editor)
    //       – AiContext (multiline text area for system-prompt augmentation)
    //   • Operating hours (the time zone itself is now editable — issue #506)
    //   • Service email and dedicated SMS sender phone for ACS notifications
    //   • Branding (logo + intake header colour) is editable — Spec A-16, issue #470
    //   • Default service-advisor / round-robin queue assignment rules
    //   • Tax / labor-rate codes per location (for downstream estimating)
    // ──────────────────────────────────────────────────────────────────────────

    private List<LocationSummaryResponseDto> _summaries = [];
    private List<TenantCapabilityDto> _tenantCapabilities = [];
    private bool _loading = true;
    private string? _error;
    private bool _dialogOpen;
    private bool _saving;
    private bool _submitted;
    private string? _editingLocationId;
    private string? _editingLocationSlug; // preserved on update; we do not change slugs from the UI
    private LocationForm _form = new();
    private MudForm? _form2;
    private bool _sendLinkOpen;
    private string? _sendLinkLocationId;
    private string? _sendLinkLocationName;
    private string? _newRecipient;
    private string? _recipientError;
    private string? _packetError;

    private const int MaxRecipients = RVS.Domain.Entities.PacketConfigEmbedded.MaxRecipients;
    private const int MinPasteBlockCharacterCap = RVS.Domain.Entities.PacketConfigEmbedded.MinPasteBlockCharacterCap;
    private const int MaxPasteBlockCharacterCap = RVS.Domain.Entities.PacketConfigEmbedded.MaxPasteBlockCharacterCap;
    private const int MaxStatusLinkTtlDays = RVS.Domain.Entities.PacketConfigEmbedded.MaxStatusLinkTtlDays;

    private string? ValidateName(string? value) =>
        _submitted && string.IsNullOrWhiteSpace(value) ? "Enter a location name" : null;

    private static string? ValidateLogoUrl(string? value) =>
        LocationBrandingValidator.ValidateLogoUrl(value).ErrorMessage;

    private static string? ValidateHeaderColor(string? value) =>
        LocationBrandingValidator.ValidateHeaderColor(value).ErrorMessage;

    // The preview paints what the intake header will: the dealer's colour, or Ink when none (or an
    // invalid one) is set, with the foreground chosen for contrast (RVS.Domain HeaderColor).
    private string HeaderPreviewBackground => HeaderColor.Normalize(_form.HeaderColor) ?? RvsBrand.Ink;

    private bool HeaderPreviewReversed => HeaderColor.PrefersLightForeground(HeaderPreviewBackground);

    private string HeaderPreviewStyle =>
        $"background-color:{HeaderPreviewBackground};color:{HeaderColor.ForegroundFor(HeaderPreviewBackground)};";

    // Same rule as the Intake app's IntakeChrome.LogoOnPlate: the logo sits straight on a colour the
    // dealer chose, and on a white plate only over the default Ink.
    private string HeaderPreviewLogoClass => HeaderColor.Normalize(_form.HeaderColor) is null
        ? "header-preview-logo header-preview-plate"
        : "header-preview-logo";

    // <input type="color"> needs lower-case #rrggbb and has no "empty" state, so it shows Ink when unset.
    private string HeaderPickerValue => HeaderPreviewBackground.ToLowerInvariant();

    private static string? ValidateAccentColor(string? value) =>
        LocationBrandingValidator.ValidateAccentColor(value).ErrorMessage;

    // The preview shows the accent customers will see — darkened if it is too light for text on
    // white — and Rust while the field is blank or not yet a hex colour.
    private string AccentPreviewColor =>
        LocationBrandingValidator.EffectiveAccent(_form.AccentColor) ?? RvsBrand.Accent;

    private bool AccentAdjusted =>
        HeaderColor.Normalize(_form.AccentColor) is { } entered && entered != AccentPreviewColor;

    private string AccentPreviewButtonStyle => $"background-color:{AccentPreviewColor};color:#FFFFFF;";

    private string AccentPreviewLinkStyle => $"color:{AccentPreviewColor};";

    // The picker shows what the dealer chose, not the darkened shade, so picking does not drift darker.
    private string AccentPickerValue =>
        (HeaderColor.Normalize(_form.AccentColor) ?? RvsBrand.Accent).ToLowerInvariant();

    private void OnAccentColorPicked(ChangeEventArgs e) =>
        _form.AccentColor = HeaderColor.Normalize(e.Value?.ToString());

    private void OnHeaderColorPicked(ChangeEventArgs e) =>
        _form.HeaderColor = HeaderColor.Normalize(e.Value?.ToString());

    /// <summary>
    /// Moves the typed address onto the recipient list. Returns false (and shows why) when the
    /// address is malformed, a duplicate, or the list is full.
    /// </summary>
    private bool AddRecipient()
    {
        var result = ClientPacketConfigValidator.ValidateNewRecipient(_newRecipient, _form.Recipients);
        if (!result.IsValid)
        {
            _recipientError = result.ErrorMessage;
            return false;
        }

        _form.Recipients.Add(_newRecipient!.Trim());
        _newRecipient = null;
        _recipientError = null;
        _packetError = null;
        return true;
    }

    private void RemoveRecipient(string address)
    {
        _form.Recipients.Remove(address);
        _packetError = null;
    }

    private void OnRecipientKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddRecipient();
        }
        else
        {
            _recipientError = null;
        }
    }

    private string GetCapabilityName(string code) =>
        _tenantCapabilities.FirstOrDefault(c => c.Code == code)?.Name ?? code;

    private void ToggleCapability(string code, bool enabled)
    {
        if (enabled)
        {
            if (!_form.EnabledCapabilities.Contains(code))
                _form.EnabledCapabilities.Add(code);
        }
        else
        {
            _form.EnabledCapabilities.Remove(code);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnThemeChanged += HandleThemeChanged;
        await Task.WhenAll(LoadLocationsAsync(), LoadTenantCapabilitiesAsync());
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= HandleThemeChanged;
    }

    private void HandleThemeChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadLocationsAsync()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            // Single network call — the summary DTO now includes slug, phone, address,
            // enabled capabilities, and createdAtUtc, so the table no longer needs a
            // per-row detail fetch (was N+1 before).
            _summaries = await LookupClient.GetLocationsAsync();
        }
        catch (AccessTokenNotAvailableException ex)
        {
            ex.Redirect();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadTenantCapabilitiesAsync()
    {
        try
        {
            var config = await LookupClient.GetTenantConfigAsync();
            _tenantCapabilities = config.AvailableCapabilities;
        }
        catch
        {
            // Capabilities are optional; don't block location load on failure
            _tenantCapabilities = [];
        }
    }

    private void ShowCreateDialog()
    {
        _editingLocationId = null;
        _editingLocationSlug = null;
        _form = new LocationForm();
        ResetPacketEditor();
        _submitted = false;
        _dialogOpen = true;
    }

    private async Task OnRowClickAsync(TableRowClickEventArgs<LocationSummaryResponseDto> args)
    {
        if (args.Item is null)
        {
            return;
        }

        try
        {
            // Detail call only happens when a row is clicked.
            var detail = await LookupClient.GetLocationByIdAsync(args.Item.LocationId);
            ShowEditDialog(detail);
        }
        catch (AccessTokenNotAvailableException ex)
        {
            ex.Redirect();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load location details: {ex.Message}", Severity.Error);
        }
    }

    private void ShowEditDialog(LocationDetailDto location)
    {
        _editingLocationId = location.Id;
        _editingLocationSlug = location.Slug;
        _submitted = false;
        _form = new LocationForm
        {
            Name = location.Name,
            Phone = location.Phone,
            TimeZoneId = location.TimeZoneId,
            Address1 = location.Address?.Address1,
            Address2 = location.Address?.Address2,
            City = location.Address?.City,
            State = location.Address?.State,
            PostalCode = location.Address?.PostalCode,
            EnabledCapabilities = [.. location.EnabledCapabilities],
            PacketEnabled = location.PacketConfig.Enabled,
            Recipients = [.. location.PacketConfig.Recipients],
            AttachPdf = location.PacketConfig.AttachPdf,
            IncludePhotos = location.PacketConfig.IncludePhotos,
            PasteBlockCharacterCap = location.PacketConfig.PasteBlockCharacterCap,
            StatusLinkTtlDays = location.PacketConfig.StatusLinkTtlDays,
            LogoUrl = location.Branding.LogoUrl,
            HeaderColor = location.Branding.HeaderColor,
            AccentColor = location.Branding.AccentColor
        };
        ResetPacketEditor();
        _dialogOpen = true;
    }

    private void ResetPacketEditor()
    {
        _newRecipient = null;
        _recipientError = null;
        _packetError = null;
    }

    private void CloseDialog()
    {
        _dialogOpen = false;
    }

    private async Task SaveLocationAsync()
    {
        _submitted = true;

        // An address typed but not yet added is almost certainly meant to be saved — the
        // common case for a new location is "enter one recipient, click Save" (Spec B-6).
        if (!string.IsNullOrWhiteSpace(_newRecipient) && !AddRecipient())
        {
            Snackbar.Add("Fix the recipient address and try again.", Severity.Warning);
            return;
        }

        var packetConfig = BuildPacketConfig();
        var packetResult = ClientPacketConfigValidator.ValidateForSave(packetConfig);
        _packetError = packetResult.ErrorMessage;

        if (_form2 is not null)
        {
            await _form2.ValidateAsync();
        }

        if ((_form2 is not null && !_form2.IsValid) || !packetResult.IsValid)
        {
            Snackbar.Add("Fix the highlighted fields and try again.", Severity.Warning);
            return;
        }

        _saving = true;
        StateHasChanged();

        try
        {
            // On create: leave Slug null so the API auto-generates {org-slug}-{name}.
            // On update: pass back the existing slug so it is preserved (changing slugs
            // from the UI is intentionally not supported here — the URL is sticky).
            var request = new LocationCreateRequestDto
            {
                Name = _form.Name ?? string.Empty,
                Slug = _editingLocationId is not null ? _editingLocationSlug : null,
                Phone = _form.Phone,
                // The drawer always shows the current zone, so an empty string here is a
                // deliberate clear rather than "unchanged" — which is what makes the
                // picker's Clearable actually clear (issue #506).
                TimeZoneId = _form.TimeZoneId ?? string.Empty,
                Address = new AddressDto
                {
                    Address1 = _form.Address1,
                    Address2 = _form.Address2,
                    City = _form.City,
                    State = _form.State,
                    PostalCode = _form.PostalCode
                },
                EnabledCapabilities = [.. _form.EnabledCapabilities],
                // Sent whole: a non-null PacketConfig replaces the stored one wholesale.
                PacketConfig = packetConfig,
                // Also sent whole, so clearing a field here clears it (Spec A-16, issue #470).
                Branding = BuildBranding()
            };

            if (_editingLocationId is not null)
            {
                await LookupClient.UpdateLocationAsync(_editingLocationId, request);
                Snackbar.Add("Location updated.", Severity.Success);
            }
            else
            {
                await LookupClient.CreateLocationAsync(request);
                Snackbar.Add("Location created.", Severity.Success);
            }

            _dialogOpen = false;
            await LoadLocationsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save location: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private PacketConfigDto BuildPacketConfig() => new()
    {
        Enabled = _form.PacketEnabled,
        Recipients = [.. _form.Recipients],
        AttachPdf = _form.AttachPdf,
        IncludePhotos = _form.IncludePhotos,
        PasteBlockCharacterCap = _form.PasteBlockCharacterCap,
        StatusLinkTtlDays = _form.StatusLinkTtlDays,
    };

    private LocationBrandingDto BuildBranding() => new()
    {
        LogoUrl = string.IsNullOrWhiteSpace(_form.LogoUrl) ? null : _form.LogoUrl.Trim(),
        HeaderColor = NormalizeFormColor(_form.HeaderColor),
        AccentColor = NormalizeFormColor(_form.AccentColor)
    };

    private static string? NormalizeFormColor(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : HeaderColor.Normalize(value) ?? value.Trim();

    private void OpenSendIntakeLink(LocationSummaryResponseDto location)
    {
        _sendLinkLocationId = location.LocationId;
        _sendLinkLocationName = location.Name;
        _sendLinkOpen = true;
    }

    private async Task DownloadQrCodeAsync(string locationId, string slug)
    {
        try
        {
            var bytes = await LookupClient.GetLocationQrCodeAsync(locationId);
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("rvs_downloadBase64", $"qr-{Uri.EscapeDataString(slug)}.png", base64, "image/png");
            Snackbar.Add("QR code downloaded.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to download QR code: {ex.Message}", Severity.Error);
        }
    }

    private static string FormatCityState(AddressDto? address)
    {
        if (address is null)
        {
            return "—";
        }

        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(address.City)) parts.Add(address.City);
        if (!string.IsNullOrWhiteSpace(address.State)) parts.Add(address.State);
        return parts.Count > 0 ? string.Join(", ", parts) : "—";
    }

    private sealed class LocationForm
    {
        public string? Name { get; set; }
        public string? Phone { get; set; }
        public string? TimeZoneId { get; set; }
        public string? Address1 { get; set; }
        public string? Address2 { get; set; }
        public string? City { get; set; }
        public string? State { get; set; }
        public string? PostalCode { get; set; }
        public List<string> EnabledCapabilities { get; set; } = [];

        // Packet settings start from the PacketConfigDto defaults, so the form and the API
        // share one definition of "works out of the box" (Spec B-6).
        private static readonly PacketConfigDto PacketDefaults = new();
        public bool PacketEnabled { get; set; } = PacketDefaults.Enabled;
        public List<string> Recipients { get; set; } = [];
        public bool AttachPdf { get; set; } = PacketDefaults.AttachPdf;
        public bool IncludePhotos { get; set; } = PacketDefaults.IncludePhotos;
        public int PasteBlockCharacterCap { get; set; } = PacketDefaults.PasteBlockCharacterCap;
        public int StatusLinkTtlDays { get; set; } = PacketDefaults.StatusLinkTtlDays;

        // Branding (Spec A-16, issue #470): blank means RV Intake's own.
        public string? LogoUrl { get; set; }
        public string? HeaderColor { get; set; }
        public string? AccentColor { get; set; }
    }
