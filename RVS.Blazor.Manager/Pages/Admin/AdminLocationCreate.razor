@page "/admin/tenants/{TenantId}/locations/new"
@inject AdminApiClient AdminApi

@* Add location to tenant (Spec P-5, issue #563). *@
<PageTitle>RVS Admin — Add location</PageTitle>

@if (_forbidden)
{
    <AccessDeniedCard />
}
else
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="px-0">
        <MudStack Spacing="3">
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="/admin"
                       Style="align-self: flex-start;">
                Tenants
            </MudButton>

            <MudStack Spacing="0">
                <MudText Typo="Typo.h4">Add location</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-family: monospace;">@TenantId</MudText>
            </MudStack>

            @if (_result is not null)
            {
                <MudPaper Elevation="2" Class="pa-4">
                    <MudStack Spacing="3">
                        <MudAlert Severity="Severity.Success">@_result.Name was added.</MudAlert>
                        <CopyField Label="Intake URL" Value="@_result.IntakeUrl" />
                        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                            <MudButton Variant="Variant.Outlined" OnClick="Reset">Add another location</MudButton>
                            <MudButton Variant="Variant.Outlined" Href="/admin">Back to tenants</MudButton>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            }

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error">@_error</MudAlert>
            }

            <MudPaper Elevation="2" Class="pa-4">
                <MudStack Spacing="3">
                    <MudTextField T="string" @bind-Value="_form.Name" Label="Location name"
                                  Variant="Variant.Outlined" Placeholder="St. George"
                                  HelperText="Saved with the business name first, e.g. &quot;Nova RV - St. George&quot;." />
                    <MudTextField T="string" @bind-Value="_form.Slug" Label="Intake slug (optional)"
                                  Variant="Variant.Outlined" HelperText="Leave blank to generate one from the names." />
                    <MudTextField T="string" @bind-Value="_form.Phone" Label="Phone (optional)"
                                  InputType="InputType.Telephone" Variant="Variant.Outlined" autocomplete="tel" />
                    <MudSelect T="string" @bind-Value="_form.TimeZoneId" Label="Time zone (optional)"
                               Variant="Variant.Outlined" Clearable="true"
                               HelperText="Sets the Received time on service packets. Leave blank to show UTC."
                               AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                        @foreach (var tz in DealershipTimeZones.All)
                        {
                            <MudSelectItem T="string" Value="@tz.IanaId">@tz.DisplayName</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField T="string" @bind-Value="_form.Recipients" Label="Packet recipients"
                                  Lines="4" Variant="Variant.Outlined"
                                  HelperText="One email per line, 1 to 10." />

                    @if (_tenantCapabilities.Count > 0)
                    {
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.subtitle2">Service capabilities</MudText>
                            @foreach (var cap in _tenantCapabilities.Where(c => c.IsActive))
                            {
                                var code = cap.Code;
                                <MudCheckBox T="bool"
                                             Value="@_form.EnabledCapabilities.Contains(code)"
                                             ValueChanged="@(v => ToggleCapability(code, v))"
                                             Label="@cap.Name"
                                             Color="Color.Primary"
                                             Dense="true" />
                            }
                        </MudStack>
                    }

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                               OnClick="SubmitAsync" Disabled="_saving">
                        @if (_saving)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Add location
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudStack>
    </MudContainer>
}

@code {
    [Parameter] public string TenantId { get; set; } = string.Empty;

    private LocationForm _form = new();
    private List<TenantCapabilityDto> _tenantCapabilities = [];
    private TenantLocationProvisioningResponseDto? _result;
    private bool _saving;
    private bool _forbidden;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var tenants = await AdminApi.ListTenantsAsync();
            _tenantCapabilities = tenants.FirstOrDefault(t => t.TenantId == TenantId)?.AvailableCapabilities ?? [];
        }
        catch (AccessTokenNotAvailableException ex)
        {
            ex.Redirect();
        }
        catch (AdminApiException ex) when (ex.IsForbidden)
        {
            _forbidden = true;
        }
    }

    private void ToggleCapability(string code, bool enabled)
    {
        if (enabled)
        {
            if (!_form.EnabledCapabilities.Contains(code))
            {
                _form.EnabledCapabilities.Add(code);
            }
        }
        else
        {
            _form.EnabledCapabilities.Remove(code);
        }
    }

    private async Task SubmitAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            _result = await AdminApi.AddLocationAsync(TenantId, new TenantLocationCreateRequestDto
            {
                Name = _form.Name ?? string.Empty,
                Slug = _form.Slug,
                Phone = _form.Phone,
                TimeZoneId = _form.TimeZoneId,
                Recipients = [.. (_form.Recipients ?? string.Empty)
                    .Split(['\n', ',', ';'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)],
                EnabledCapabilities = [.. _form.EnabledCapabilities]
            });
        }
        catch (AccessTokenNotAvailableException ex)
        {
            ex.Redirect();
        }
        catch (AdminApiException ex) when (ex.IsForbidden)
        {
            _forbidden = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void Reset()
    {
        _result = null;
        _error = null;
        _form = new LocationForm();
    }

    private sealed class LocationForm
    {
        public string? Name { get; set; }
        public string? Slug { get; set; }
        public string? Phone { get; set; }
        public string? TimeZoneId { get; set; }
        public string? Recipients { get; set; }
        public List<string> EnabledCapabilities { get; set; } = [];
    }
}
