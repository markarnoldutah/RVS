@page "/"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@inject RVS.UI.Shared.Services.LookupApiClient LookupClient
@inject RVS.Blazor.Manager.State.ManagerAppState AppState
@implements IDisposable

<PageTitle>RV Intake Manager — Home</PageTitle>

<AuthorizeView>
    <Authorized>
        <MudStack Spacing="5" Class="pa-6">
            <MudText Typo="Typo.h4" GutterBottom="true">
                Welcome, @GetDisplayName(context)!
            </MudText>

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
                <LocationSelector />
                @if (AppState.SelectedLocation is not null)
                {
                    @* Spec A-14: the advisor is on a call — one click from the landing page. *@
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Sms"
                               OnClick="OpenSendIntakeLinkAsync"
                               Style="text-transform: none;">
                        Send intake link
                    </MudButton>
                }
            </MudStack>

            <SendIntakeLinkDialog @bind-Visible="_sendLinkOpen"
                                  LocationId="@AppState.SelectedLocation"
                                  LocationName="@_selectedLocationName" />

            @if (AppState.SelectedLocation is null)
            {
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudStack Spacing="3">
                            <MudIcon Icon="@Icons.Material.Filled.Dashboard"
                                     Color="Color.Primary" Size="Size.Large"
                                     aria-hidden="true" />
                            <MudText Typo="Typo.h6">Manager Dashboard</MudText>
                            <MudText Typo="Typo.body1" Color="Color.Secondary">
                                Select a location above to begin managing service requests.
                            </MudText>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            }
        </MudStack>
    </Authorized>
    <NotAuthorized>
        <AuthStatePanel Message="Manage service requests and operations"
                        ButtonText="Log In"
                        ButtonHref="authentication/login" />
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _sendLinkOpen;
    private string? _selectedLocationName;

    protected override void OnInitialized()
    {
        // The Send intake link button appears once LocationSelector auto-selects or restores a location.
        AppState.OnLocationChanged += OnLocationChangedAsync;
    }

    private Task OnLocationChangedAsync(string? _)
    {
        _selectedLocationName = null;
        return InvokeAsync(StateHasChanged);
    }

    private async Task OpenSendIntakeLinkAsync()
    {
        // Open first: the advisor is on a call. The store name only fills in the consent
        // script, which has a placeholder, so it arrives behind the dialog, best effort.
        _sendLinkOpen = true;
        StateHasChanged();

        if (_selectedLocationName is not null)
        {
            return;
        }

        try
        {
            var locations = await LookupClient.GetLocationsAsync();
            _selectedLocationName = locations
                .FirstOrDefault(l => l.LocationId == AppState.SelectedLocation)?.Name;
        }
        catch (AccessTokenNotAvailableException ex)
        {
            ex.Redirect();
        }
        catch (HttpRequestException)
        {
            // Placeholder stays.
        }
    }

    public void Dispose() => AppState.OnLocationChanged -= OnLocationChangedAsync;

    private static string GetDisplayName(AuthenticationState context)
    {
        return context.User.Identity?.Name
            ?? context.User.FindFirst("email")?.Value
            ?? "Manager";
    }
}