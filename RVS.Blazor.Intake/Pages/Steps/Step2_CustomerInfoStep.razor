<MudPaper Elevation="2" Class="pa-6 rounded-lg wizard-step-card">
    <MudForm @ref="_form">
        <MudStack Spacing="4">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h5" Style="color: var(--mud-palette-text-primary);">Contact</MudText>
                <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">
                    Tell us how to reach you regarding your service request.
                </MudText>
            </MudStack>

            @if (State.IsPrefilled)
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Dense="true">
                    Your information has been pre-filled from your previous visit.
                </MudAlert>
            }

            @if (State.IsRememberedPrefilled)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="1">
                        <MudText Typo="Typo.body1">Filled in from your last visit on this device.</MudText>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Primary"
                                   OnClick="HandleNotYou"
                                   Style="text-transform: none;">
                            Not you? Clear it
                        </MudButton>
                    </MudStack>
                </MudAlert>
            }

            <MudPaper Elevation="1" Class="pa-4" Style="background: var(--mud-palette-background);">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.body1" Style="font-weight: 700; color: var(--mud-palette-text-primary);">First name</MudText>
                    <MudTextField @bind-Value="State.FirstName"
                                  T="string"
                                  Validation="@(new Func<string?, string?>(ValidateFirstName))"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  autocomplete="given-name" />
                </MudStack>
            </MudPaper>

            <MudPaper Elevation="1" Class="pa-4" Style="background: var(--mud-palette-background);">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.body1" Style="font-weight: 700; color: var(--mud-palette-text-primary);">Last name</MudText>
                    <MudTextField @bind-Value="State.LastName"
                                  T="string"
                                  Validation="@(new Func<string?, string?>(ValidateLastName))"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  autocomplete="family-name" />
                </MudStack>
            </MudPaper>

            <MudPaper Elevation="1" Class="pa-4" Style="background: var(--mud-palette-background);">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.body1" Style="font-weight: 700; color: var(--mud-palette-text-primary);">Email</MudText>
                    <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">We'll email service updates to this address. Opt out below</MudText>
                    <MudTextField @bind-Value="State.Email"
                                  T="string"
                                  Validation="@(new Func<string?, string?>(ValidateEmail))"
                                  InputType="InputType.Email"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Placeholder="you@example.com"
                                  autocomplete="email" />
                </MudStack>
            </MudPaper>

            <MudPaper Elevation="1" Class="pa-4" Style="background: var(--mud-palette-background);">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.body1" Style="font-weight: 700; color: var(--mud-palette-text-primary);">Phone</MudText>
                    <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">
                        We'll text service updates to this number. Opt out below. 
                    </MudText>
                    <MudTextField @bind-Value="State.Phone"
                                  T="string"
                                  Validation="@(new Func<string?, string?>(ValidatePhone))"
                                  Mask="_phoneMask"
                                  InputType="InputType.Telephone"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Placeholder="(555) 123-4567"
                                  autocomplete="tel" />
                </MudStack>
            </MudPaper>

            <MudPaper Elevation="1" Class="pa-4" Style="background: var(--mud-palette-background);">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.body1" Style="font-weight: 700; color: var(--mud-palette-text-primary);">Notification Preferences</MudText>
                    <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">
                        We'll confirm your request by text if you prefer text, otherwise by email.
                        Texts are only about your service request; message frequency varies.
                        Message and data rates may apply. Reply STOP to opt out, HELP for help.
                        <MudLink Href="/sms-terms" Target="_blank" Typo="Typo.body1">Texting terms</MudLink>
                    </MudText>
                    <MudCheckBox @bind-Value="State.SmsOptOut"
                                 T="bool"
                                 Label="Do not send text messages"
                                 Color="Color.Primary" />
                    <MudCheckBox @bind-Value="State.EmailOptOut"
                                 T="bool"
                                 Label="Do not send email"
                                 Color="Color.Primary" />
                </MudStack>
            </MudPaper>

            <MudPaper Elevation="1" Class="pa-4" Style="background: var(--mud-palette-background);">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.body1" Style="font-weight: 700; color: var(--mud-palette-text-primary);">Preferred contact method</MudText>
                    <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">
                        How should the service team reach you first?
                    </MudText>
                    <MudRadioGroup T="string"
                                   @bind-Value="State.PreferredContact"
                                   Validation="@(new Func<string?, string?>(ValidatePreferredContact))">
                        <MudRadio T="string" Value="@("Phone")" Color="Color.Primary">Phone call</MudRadio>
                        <MudRadio T="string" Value="@("Text")" Color="Color.Primary"
                                  Disabled="@(!State.IsContactMethodAvailable("Text"))">Text message</MudRadio>
                        <MudRadio T="string" Value="@("Email")" Color="Color.Primary"
                                  Disabled="@(!State.IsContactMethodAvailable("Email"))">Email</MudRadio>
                    </MudRadioGroup>
                </MudStack>
            </MudPaper>

            @if (State.CanRememberDetails)
            {
                <MudPaper Elevation="1" Class="pa-4" Style="background: var(--mud-palette-background);">
                    <MudStack Spacing="1">
                        <MudCheckBox T="bool"
                                     Value="State.RememberDetails"
                                     ValueChanged="HandleRememberChanged"
                                     Label="Remember my name, email, phone and VIN on this device"
                                     Color="Color.Primary" />
                        <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">
                            Saves typing next time. Leave it unticked on a shared or dealership device.
                        </MudText>
                    </MudStack>
                </MudPaper>
            }

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       OnClick="HandleNext"
                       Style="text-transform: none;"
                       Class="mt-6">
                Continue
            </MudButton>
        </MudStack>
    </MudForm>
</MudPaper>

@code {
    [Parameter, EditorRequired] public IntakeWizardState State { get; set; } = default!;
    [Parameter, EditorRequired] public EventCallback OnNext { get; set; }
    [Inject] private RememberedDetailsStore RememberedDetails { get; set; } = default!;

    private MudForm _form = default!;
    private bool _submitted;

    // Issue #758: refuse letters at the keystroke; the rule below still counts the digits.
    private readonly IMask _phoneMask = new RegexMask(PhoneInputMask.Pattern, "(555) 123-4567");

    private string? ValidateFirstName(string? value) =>
        _submitted && string.IsNullOrWhiteSpace(value) ? "First name is required" : null;

    private string? ValidateLastName(string? value) =>
        _submitted && string.IsNullOrWhiteSpace(value) ? "Last name is required" : null;

    private string? ValidateEmail(string? value)
    {
        if (!_submitted) return null;
        if (string.IsNullOrWhiteSpace(value)) return "Email is required";
        var result = EmailValidator.Validate(value);
        return result.IsValid ? null : result.ErrorMessage;
    }

    private string? ValidatePhone(string? value)
    {
        if (!_submitted) return null;
        var result = PhoneValidator.Validate(value);
        return result.IsValid ? null : result.ErrorMessage;
    }

    private string? ValidatePreferredContact(string? value)
    {
        if (!_submitted) return null;
        if (string.IsNullOrWhiteSpace(value)) return "Preferred contact method is required";
        if (!State.IsContactMethodAvailable(value))
        {
            return "You've opted out of that channel. Choose another preferred contact method.";
        }
        return null;
    }

    // Issue #811: unticking forgets at once, not at submission, so a customer who changes their
    // mind and walks away leaves nothing behind.
    private async Task HandleRememberChanged(bool remember)
    {
        State.RememberDetails = remember;
        if (!remember)
        {
            await RememberedDetails.ForgetAsync();
        }
        await State.PersistAsync();
    }

    private async Task HandleNotYou()
    {
        State.ClearRememberedDetails();
        await RememberedDetails.ForgetAsync();
        await State.PersistAsync();
    }

    private async Task HandleNext()
    {
        _submitted = true;
        await _form.Validate();
        if (!_form.IsValid) return;

        await State.NotifyAndPersistAsync();
        await OnNext.InvokeAsync();
    }
}
