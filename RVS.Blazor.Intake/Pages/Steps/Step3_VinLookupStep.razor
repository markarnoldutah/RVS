<MudPaper Elevation="2" Class="pa-6 rounded-lg wizard-step-card">
    <MudForm @ref="_form">
    <MudStack Spacing="4">
        <MudText Typo="Typo.h5" Class="mb-1" Style="color: var(--mud-palette-text-primary);">RV Lookup</MudText>

        @* Known-vehicle picker: A-7, deferred and unreachable (Spec A-7, #673). Kept for when A-7 returns. *@
        @if (State.KnownAssets is { Count: > 0 })
        {
            <MudStack Spacing="1">
                <MudText Typo="Typo.body1" Style="font-weight: 700; color: var(--mud-palette-text-primary);">Previously seen RVs</MudText>
                <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">
                    Select a previously seen RV or enter a new one below
                </MudText>
            </MudStack>

            <MudRadioGroup T="string" Value="@State.Vin" ValueChanged="HandleKnownAssetSelected"
                           InputStyle="display: flex; flex-direction: column; align-items: flex-start;">
                @foreach (var asset in State.KnownAssets)
                {
                    var label = FormatAssetLabel(asset);
                    <MudRadio T="string" Value="@asset.AssetId" Color="Color.Primary" Dense="true">
                        @label
                    </MudRadio>
                }
            </MudRadioGroup>

            <MudDivider Class="my-1" />
        }

        <MudPaper Elevation="1" Class="pa-4" Style="background: var(--mud-palette-background);">
            <MudStack Spacing="1">
                <MudText Typo="Typo.body1" Style="font-weight: 700; color: var(--mud-palette-text-primary);">VIN or serial number</MudText>
                <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">Enter, speak, or snap a pic of your VIN. No VIN? A truck camper, for example, has a shorter serial number on its plate. Use that.</MudText>
                <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="1">
                    <MudTextField T="string"
                                  Value="@State.Vin"
                                  ValueChanged="HandleVinChanged"
                                  Validation="@(new Func<string?, string?>(ValidateVin))"
                                  MaxLength="VehicleIdentifierValidator.MaxLength"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Placeholder="VIN or serial number"
                                  Immediate="true"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_isRecording ? Icons.Material.Filled.MicOff : Icons.Material.Filled.Mic)"
                                  AdornmentColor="@(_isRecording ? Color.Error : Color.Primary)"
                                  OnAdornmentClick="ToggleVinRecording"
                                  Disabled="_isTranscribing"
                                  Style="max-width: 27ch;" />
                    <MudIconButton Icon="@Icons.Material.Filled.PhotoCamera"
                               Color="Color.Info" 
                               Variant="Variant.Filled"
                               Size="Size.Medium"
                               OnClick="TriggerCameraCapture"
                               Disabled="@(_isRecording || _isTranscribing)"
                               Style="height: 63px; width: 60px; padding: 8px; margin-top: 4px;"
                               aria-label="Capture VIN or serial number with camera" />
                </MudStack>
                <VoiceRecordingIndicator IsRecording="_isRecording"
                                          ElapsedSeconds="_recordingElapsedSeconds"
                                          MaxSeconds="MaxRecordingSeconds"
                                          WarningSeconds="RecordingCapWarningSeconds"
                                          Announcement="_recordingAnnouncement" />
                @if (_isTranscribing)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudProgressCircular Size="Size.Small" Color="Color.Primary" Indeterminate="true" />
                        <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">Transcribing…</MudText>
                    </MudStack>
                }
                @if (_transcriptionError is not null)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true">
                        <MudText Typo="Typo.body2">@_transcriptionError</MudText>
                    </MudAlert>
                }
            </MudStack>
        </MudPaper>

        @* Issue #736: the VIN photo is taken in the page. The phone's camera app, reached through
           this input, is only the fallback when the in-page camera will not start. *@
        @if (_cameraOpen)
        {
            <CameraOverlay Caption="Fit the VIN or serial number plate in the frame"
                           OnCaptured="HandleInPageCapture"
                           OnClose="() => _cameraOpen = false"
                           OnUseNativeCamera="UseNativeCamera" />
        }

        <InputFile @ref="_cameraInput"
                   accept="image/*"
                   capture="environment"
                   OnChange="HandleCameraCapture"
                   style="display: none;" />

        @if (_isExtracting && _capturedImageUrl is null)
        {
            <MudPaper Elevation="1" Class="pa-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                    <MudText Typo="Typo.body2">Processing image…</MudText>
                </MudStack>
            </MudPaper>
        }

        @if (_capturedImageUrl is not null)
        {
            <MudPaper Elevation="1" Class="pa-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <div style="position: relative; width: 48px; height: 48px; flex-shrink: 0;">
                        <img src="@_capturedImageUrl" alt="Captured VIN or serial number photo"
                             style="width: 48px; height: 48px; object-fit: cover; border-radius: 4px;" />
                        @if (_isExtracting)
                        {
                            <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.7); border-radius: 4px;">
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                            </div>
                        }
                    </div>
                    <MudStack Spacing="0" Style="flex: 1; min-width: 0;">
                        <MudText Typo="Typo.body2">
                            @(_isExtracting ? "Reading the photo…" : "Photo captured")
                        </MudText>
                    </MudStack>
                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   Size="Size.Small"
                                   Disabled="_isExtracting"
                                   OnClick="ClearCapturedImage"
                                   aria-label="Remove captured photo" />
                </MudStack>
            </MudPaper>
        }

        @if (_extractionMessage is not null)
        {
            <MudAlert Severity="@_extractionSeverity" Variant="Variant.Filled" Dense="true">
                <MudText Typo="Typo.body2">@_extractionMessage</MudText>
            </MudAlert>
        }

        @if (_lookupFailed)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="false"
                      Icon="@Icons.Material.Filled.ErrorOutline">
                <MudText Typo="Typo.body2">
                    We tried to retrieve your RV's information but could not. Are you sure the information is correct?
                </MudText>
            </MudAlert>
        }

        <MudStack Spacing="2" Class="mt-6">
            @if (_lookupFailed)
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           FullWidth="true"
                           OnClick="HandleProceedAnyway"
                           Style="text-transform: none;">
                    Continue Anyway
                </MudButton>
            }
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Disabled="_isLookingUp"
                       OnClick="HandleLookup"
                       Style="text-transform: none;">
                @if (_isLookingUp)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    @:Looking up…
                }
                else if (_lookupFailed)
                {
                    @:Try Lookup Again
                }
                else
                {
                    @:Continue
                }
            </MudButton>
            @* Issue #807: a rig in storage can't be read. The dealer collects its details later. *@
            <MudButton Variant="Variant.Text"
                       Color="Color.Primary"
                       FullWidth="true"
                       Disabled="@(_isLookingUp || _isExtracting || _isTranscribing)"
                       OnClick="HandleSkip"
                       Style="text-transform: none;">
                Skip for now. My RV isn't with me
            </MudButton>
        </MudStack>
    </MudStack>
    </MudForm>
</MudPaper>

@implements IDisposable
@code {
    private const double VinAutoFillThreshold = 0.7;
    private const double VinAutoLookupThreshold = 0.9;

    // Spec A-9: voice is optional and advisory — this cap exists only so a forgotten
    // recording doesn't produce a huge upload, not to gate the wizard.
    private const int MaxRecordingSeconds = 120;
    private const int RecordingCapWarningSeconds = 15;

    [Parameter, EditorRequired] public IntakeWizardState State { get; set; } = default!;
    [Parameter, EditorRequired] public EventCallback OnNext { get; set; }
    [Inject] private IntakeApiClient IntakeApi { get; set; } = default!;
    [Inject] private IJSRuntime JsRuntime { get; set; } = default!;

    private MudForm _form = default!;
    private bool _submitted;
    private InputFile? _cameraInput;
    private bool _cameraOpen;
    private string? _capturedImageUrl;
    private bool _isLookingUp;
    private bool _isExtracting;
    private bool _isRecording;
    private bool _isTranscribing;
    private bool _lookupFailed;
    private string? _extractionMessage;
    private string? _transcriptionError;
    private Severity _extractionSeverity = Severity.Info;
    private RecordingTimer? _recordingTimer;
    private int _recordingElapsedSeconds;
    private string _recordingAnnouncement = string.Empty;

    // Issue #807: a VIN or any serial number. The check digit is not enforced here — a VIN that
    // will not decode already has "Continue Anyway".
    private string? ValidateVin(string? value)
    {
        if (!_submitted) return null;
        var result = VehicleIdentifierValidator.Validate(value);
        return result.IsValid ? null : result.ErrorMessage;
    }

    private void HandleVinChanged(string? value)
    {
        State.Vin = VehicleIdentifierValidator.Normalize(value);
        State.VehicleSkipped = false;
        State.VinLookupSucceeded = false;
        _lookupFailed = false;
    }

    private void HandleKnownAssetSelected(string? assetId)
    {
        if (string.IsNullOrWhiteSpace(assetId)) return;

        var asset = State.KnownAssets?.FirstOrDefault(a =>
            string.Equals(a.AssetId, assetId, StringComparison.OrdinalIgnoreCase));

        if (asset is null) return;

        SelectKnownAsset(asset);
    }

    private void SelectKnownAsset(AssetInfoDto asset)
    {
        State.Vin = asset.AssetId;
        State.Manufacturer = asset.Manufacturer;
        State.Model = asset.Model;
        State.Year = asset.Year;
        _lookupFailed = false;
        StateHasChanged();
    }

    private static string FormatAssetLabel(AssetInfoDto asset)
    {
        var parts = new List<string>();
        if (asset.Year.HasValue)
            parts.Add(asset.Year.Value.ToString());
        if (!string.IsNullOrWhiteSpace(asset.Manufacturer))
            parts.Add(asset.Manufacturer);
        if (!string.IsNullOrWhiteSpace(asset.Model))
            parts.Add(asset.Model);

        return parts.Count > 0 ? string.Join(" ", parts) : asset.AssetId;
    }

    private void TriggerCameraCapture()
    {
        _cameraOpen = true;
    }

    /// <summary>The in-page camera would not start: fall back to the phone's camera app.</summary>
    private async Task UseNativeCamera()
    {
        _cameraOpen = false;
        if (_cameraInput?.Element is not null)
        {
            await JsRuntime.InvokeVoidAsync("rvs_triggerClick", _cameraInput.Element);
        }
    }

    private async Task HandleInPageCapture(CapturedMedia media)
    {
        // One photo is all the VIN needs; the camera closes, and the extraction shows under the field.
        _cameraOpen = false;
        if (media.Bytes.Length > VinPhoto.MaxUploadBytes)
        {
            _extractionMessage = "We couldn't use that photo. Please try again, or type the number in.";
            _extractionSeverity = Severity.Warning;
            return;
        }

        await ExtractVinFromPhotoAsync(new VinPhotoImage(media.Bytes, media.ContentType));
    }

    private async Task ToggleVinRecording()
    {
        if (_isRecording)
        {
            StopRecordingTimer();
            _isRecording = false;
            _recordingAnnouncement = "Recording stopped";
            _isTranscribing = true;
            _transcriptionError = null;
            StateHasChanged();

            try
            {
                var recording = await JsRuntime.InvokeAsync<AudioRecordingResult?>("rvs_stopRecording");
                if (recording is null || string.IsNullOrWhiteSpace(recording.Audio))
                {
                    _transcriptionError = "No audio was captured.";
                    return;
                }

                var request = new IssueTranscriptionRequestDto
                {
                    AudioBase64 = recording.Audio,
                    ContentType = recording.MimeType
                };

                var result = await IntakeApi.TranscribeIssueAsync(State.Slug, request);
                if (result?.Result?.RawTranscript is not null)
                {
                    var vin = VinTranscriptCleaner.Clean(result.Result.RawTranscript);
                    if (!string.IsNullOrEmpty(vin))
                    {
                        HandleVinChanged(vin);
                    }
                    else
                    {
                        _transcriptionError = "Could not recognize a VIN or serial number from the audio. Please try again or type it manually.";
                    }
                }
                else
                {
                    _transcriptionError = "Could not transcribe the audio. Please try again or type it manually.";
                }
            }
            catch (Exception)
            {
                _transcriptionError = "Transcription failed. Please try again or type it manually.";
            }
            finally
            {
                _isTranscribing = false;
                StateHasChanged();
            }
        }
        else
        {
            _transcriptionError = null;
            try
            {
                await JsRuntime.InvokeVoidAsync("rvs_startRecording");
                _isRecording = true;
                _recordingElapsedSeconds = 0;
                _recordingAnnouncement = "Recording started";
                StartRecordingTimer();
            }
            catch (Exception)
            {
                _transcriptionError = "Microphone access was denied or is unavailable.";
            }
        }
    }

    private void StartRecordingTimer()
    {
        _recordingTimer?.Dispose();
        _recordingTimer = new RecordingTimer(
            MaxRecordingSeconds,
            onTick: () =>
            {
                _recordingElapsedSeconds = _recordingTimer!.ElapsedSeconds;
                StateHasChanged();
            },
            onAutoStop: ToggleVinRecording);
        _recordingTimer.Start();
    }

    private void StopRecordingTimer()
    {
        _recordingTimer?.Dispose();
        _recordingTimer = null;
    }

    public void Dispose()
    {
        _recordingTimer?.Dispose();
    }

    private async Task HandleCameraCapture(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        _extractionMessage = null;
        _capturedImageUrl = null;
        _isExtracting = true;
        StateHasChanged();

        // Issue #736: shrunk in the browser and read whole. A full-size Android photo was over the
        // API's limit, and a single read took only its first chunk.
        var photo = await VinPhoto.ReadAsync(file, VinPhoto.ResizeInBrowser);
        if (photo is null)
        {
            _isExtracting = false;
            _extractionMessage = "We couldn't use that photo. Please try again, or type the number in.";
            _extractionSeverity = Severity.Warning;
            StateHasChanged();
            return;
        }

        await ExtractVinFromPhotoAsync(photo);
    }

    private async Task ExtractVinFromPhotoAsync(VinPhotoImage photo)
    {
        _extractionMessage = null;
        _isExtracting = true;
        _capturedImageUrl = photo.DataUrl;
        StateHasChanged();

        try
        {
            var request = new VinExtractionRequestDto
            {
                ImageBase64 = photo.Base64,
                ContentType = photo.ContentType
            };

            var response = await IntakeApi.ExtractVinFromImageAsync(State.Slug, request);

            if (response is { Success: true, Result.Vin: { } vin } && response.Confidence >= VinAutoFillThreshold)
            {
                HandleVinChanged(vin);
                // Issue #807: whatever else the plate shows pre-fills Step 4, where the customer can change it.
                State.ApplyVehicleDetailsFromPhoto(response.Result.Manufacturer, response.Result.Model, response.Result.Year);
                _extractionSeverity = Severity.Success;

                // Issue #807: a serial number has no check digit and nothing to decode, so the
                // customer confirms it with Continue rather than the wizard moving on by itself.
                if (!State.HasVin)
                {
                    _extractionMessage = $"Serial number read from photo: {State.Vin}. Check it, then tap Continue.";
                }
                else
                {
                    _extractionMessage = $"VIN extracted from photo: {State.Vin}";

                    if (response.Confidence >= VinAutoLookupThreshold)
                    {
                        StateHasChanged();
                        await Task.Yield();
                        await HandleLookup();
                        return;
                    }
                }
            }
            else
            {
                _extractionMessage = "We couldn't read a VIN or serial number from the photo. Please type it in.";
                _extractionSeverity = Severity.Info;
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            _extractionMessage = "We couldn't read a VIN or serial number from the photo. Please type it in.";
            _extractionSeverity = Severity.Info;
        }
        finally
        {
            _isExtracting = false;
            StateHasChanged();
        }
    }

    private void ClearCapturedImage()
    {
        _capturedImageUrl = null;
        _extractionMessage = null;
    }

    private async Task HandleLookup()
    {
        _lookupFailed = false;

        _submitted = true;
        await _form.Validate();
        if (!_form.IsValid) return;

        // Issue #807: only a VIN can be decoded. A serial number goes straight to manual entry in
        // Step 4, pre-filled with the number.
        if (!State.HasVin)
        {
            State.VinLookupSucceeded = false;
            await State.NotifyAndPersistAsync();
            await OnNext.InvokeAsync();
            return;
        }

        _isLookingUp = true;
        StateHasChanged();

        try
        {
            var decoded = await IntakeApi.DecodeVinAsync(State.Slug, State.Vin);
            if (decoded is not null)
            {
                State.ApplyVinDecode(decoded);
                await State.NotifyAndPersistAsync();
                await OnNext.InvokeAsync();
            }
            else
            {
                _lookupFailed = true;
            }
        }
        catch (HttpRequestException)
        {
            _lookupFailed = true;
        }
        catch (TaskCanceledException)
        {
            _lookupFailed = true;
        }
        finally
        {
            _isLookingUp = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Advances to the next step without a successful VIN decode,
    /// allowing the user to enter vehicle details manually.
    /// </summary>
    private async Task HandleProceedAnyway()
    {
        await State.NotifyAndPersistAsync();
        await OnNext.InvokeAsync();
    }

    /// <summary>
    /// Moves on without a VIN or serial number: the rig is in storage and the dealer will collect
    /// its details later (issue #807). Clears anything a decode filled, so Step 4 starts empty
    /// and optional.
    /// </summary>
    private async Task HandleSkip()
    {
        State.SkipVehicle();
        _lookupFailed = false;
        await State.NotifyAndPersistAsync();
        await OnNext.InvokeAsync();
    }

    /// <summary>
    /// Mirrors the JS object returned by rvs_stopRecording: { audio, mimeType }.
    /// </summary>
    private sealed record AudioRecordingResult(string? Audio, string MimeType);
}
