<MudPaper Elevation="2" Class="pa-6 rounded-lg wizard-step-card">
    <MudStack Spacing="4">
        <MudStack Spacing="1">
            <MudText Typo="Typo.h5" Style="color: var(--mud-palette-text-primary);">Review &amp; Submit</MudText>
            <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">
                Please review your information before submitting.
            </MudText>
        </MudStack>

        @* Issue #773: the Submit button sits below a long summary — without this, a customer
           can read the review, assume they're done and close the tab. *@
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true">
            Your request has <strong>not</strong> been sent yet. Scroll down and tap
            <strong>Submit Service Request</strong> at the bottom of this page to finish.
        </MudAlert>

        @* Contact Information *@
        <MudPaper Elevation="1" Class="pa-4" Style="background: var(--mud-palette-background);">
            <MudStack Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.h6" Style="color: var(--mud-palette-text-primary);">Contact Information</MudText>
                    <MudSpacer />
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Edit"
                               OnClick="() => EditStep(2)"
                               Style="text-transform: none;">Edit</MudButton>
                </MudStack>
                <MudSimpleTable Elevation="0" Class="review-table">
                    <tbody>
                        <tr><td><strong>Name</strong></td><td>@State.FirstName @State.LastName</td></tr>
                        <tr><td><strong>Email</strong></td><td>@State.Email</td></tr>
                        @if (!string.IsNullOrWhiteSpace(State.Phone))
                        {
                            <tr><td><strong>Phone</strong></td><td>@State.Phone</td></tr>
                        }
                        <tr>
                            <td><strong>Notifications</strong></td>
                            <td>@GetNotificationSummary()</td>
                        </tr>
                    </tbody>
                </MudSimpleTable>
            </MudStack>
        </MudPaper>

        @* Vehicle Information *@
        <MudPaper Elevation="1" Class="pa-4" Style="background: var(--mud-palette-background);">
            <MudStack Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.h6" Style="color: var(--mud-palette-text-primary);">Vehicle Information</MudText>
                    <MudSpacer />
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Edit"
                               OnClick="() => EditStep(3)"
                               Style="text-transform: none;">Edit</MudButton>
                </MudStack>
                <MudSimpleTable Elevation="0" Class="review-table">
                    <tbody>
                        @if (State.VehicleSkipped)
                        {
                            <tr><td><strong>VIN</strong></td><td>Skipped. The service team will collect it.</td></tr>
                        }
                        else
                        {
                            <tr><td><strong>@(State.HasVin ? "VIN" : "Serial number")</strong></td><td>@State.Vin</td></tr>
                        }
                        @if (!string.IsNullOrWhiteSpace(State.Manufacturer))
                        {
                            <tr><td><strong>Manufacturer</strong></td><td>@State.Manufacturer</td></tr>
                        }
                        @if (!string.IsNullOrWhiteSpace(State.Model))
                        {
                            <tr><td><strong>Model</strong></td><td>@State.Model</td></tr>
                        }
                        @if (State.Year.HasValue)
                        {
                            <tr><td><strong>Year</strong></td><td>@State.Year</td></tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudStack>
        </MudPaper>

        @* Spec A-17 (issue #806): one group per issue. With a single issue the groups read
           exactly as the review always has; with several, each is headed and can be removed. *@
        @{
            var issues = State.GetIssues();
            var isMultiIssue = issues.Count > 1;
        }
        @for (var index = 0; index < issues.Count; index++)
        {
            var issueIndex = index;
            var issue = issues[issueIndex];

            @* Issue #810: with several issues, each one's header and sections sit in a card of
               their own, so the issues read apart at a glance. One issue gets no card, and reads
               as the review always has. *@
            <div class="@(isMultiIssue ? "issue-card" : null)">
                <MudStack Spacing="4">
                    @if (isMultiIssue)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.h6" Style="color: var(--mud-palette-text-primary);">
                                Issue @(issueIndex + 1) of @issues.Count
                            </MudText>
                            <MudSpacer />
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                           Color="Color.Default"
                                           Disabled="_isSubmitting"
                                           OnClick="() => RemoveIssue(issueIndex)"
                                           title="@($"Remove issue {issueIndex + 1}")"
                                           aria-label="@($"Remove issue {issueIndex + 1}")" />
                        </MudStack>
                    }

                    @* Issue Details *@
                    <MudPaper Elevation="1" Class="pa-4" Style="background: var(--mud-palette-background);">
                        <MudStack Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudText Typo="Typo.h6" Style="color: var(--mud-palette-text-primary);">Issue Details</MudText>
                                <MudSpacer />
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Edit"
                                           OnClick="() => EditIssue(issueIndex, 5)"
                                           Style="text-transform: none;">Edit</MudButton>
                            </MudStack>
                            <MudSimpleTable Elevation="0" Class="review-table">
                                <tbody>
                                    <tr><td><strong>Category</strong></td><td>@issue.IssueCategory</td></tr>
                                    <tr><td><strong>Description</strong></td><td style="white-space: pre-wrap;">@issue.IssueDescription</td></tr>
                                    @if (!string.IsNullOrWhiteSpace(issue.Urgency))
                                    {
                                        <tr><td><strong>Urgency</strong></td><td>@issue.Urgency</td></tr>
                                    }
                                    @* Asked once for the visit, so shown once, with the first issue. *@
                                    @if (issueIndex == 0)
                                    {
                                        @if (!string.IsNullOrWhiteSpace(State.RvUsage))
                                        {
                                            <tr><td><strong>RV Usage</strong></td><td>@State.RvUsage</td></tr>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(State.HasExtendedWarranty))
                                        {
                                            <tr><td><strong>Extended Warranty</strong></td><td>@State.HasExtendedWarranty</td></tr>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(State.ApproxPurchaseDate))
                                        {
                                            <tr><td><strong>Approx. Purchase Date</strong></td><td>@State.ApproxPurchaseDate</td></tr>
                                        }
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </MudStack>
                    </MudPaper>

                    @* Diagnostic Responses *@
                    @if (issue.DiagnosticResponses.Count > 0)
                    {
                        <MudPaper Elevation="1" Class="pa-4" Style="background: var(--mud-palette-background);">
                            <MudStack Spacing="2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudText Typo="Typo.h6" Style="color: var(--mud-palette-text-primary);">Diagnostic Responses</MudText>
                                    <MudSpacer />
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Edit"
                                               OnClick="() => EditIssue(issueIndex, 6)"
                                               Style="text-transform: none;">Edit</MudButton>
                                </MudStack>
                                <MudStack Spacing="3">
                                    @foreach (var response in issue.DiagnosticResponses)
                                    {
                                        <div>
                                            <MudText Typo="Typo.body1" Style="font-weight: 500;">
                                                @response.QuestionText
                                            </MudText>
                                            @if (response.SelectedOptions.Count > 0)
                                            {
                                                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-1">
                                                    @foreach (var option in response.SelectedOptions)
                                                    {
                                                        <MudChip T="string" Color="Color.Primary"
                                                                 Variant="Variant.Outlined">
                                                            @option
                                                        </MudChip>
                                                    }
                                                </MudStack>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(response.FreeTextResponse))
                                            {
                                                <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);" Class="mt-1">
                                                    @response.FreeTextResponse
                                                </MudText>
                                            }
                                        </div>
                                    }
                                </MudStack>
                            </MudStack>
                        </MudPaper>
                    }

                    @* Attachments *@
                    @if (issue.Attachments.Count > 0)
                    {
                        <MudPaper Elevation="1" Class="pa-4" Style="background: var(--mud-palette-background);">
                            <MudStack Spacing="2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudText Typo="Typo.h6" Style="color: var(--mud-palette-text-primary);">
                                        Attachments (@issue.Attachments.Count)
                                    </MudText>
                                    <MudSpacer />
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Edit"
                                               OnClick="() => EditIssue(issueIndex, 7)"
                                               Style="text-transform: none;">Edit</MudButton>
                                </MudStack>
                                @* Issue #768: thumbnails, not file names — camera names like IMG_4521.jpg say nothing. *@
                                <ul class="attachment-thumbs">
                                    @foreach (var attachment in issue.Attachments)
                                    {
                                        <li class="attachment-thumb" title="@attachment.FileName">
                                            @if (attachment.ThumbnailDataUrl is not null)
                                            {
                                                <img src="@attachment.ThumbnailDataUrl" alt="@attachment.FileName" />
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@AttachmentSlots.FileIcon(attachment.ContentType)" Color="Color.Primary" />
                                                <span class="attachment-thumb-name">@attachment.FileName</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            </div>
        }

        @* Spec A-17: another issue with the same RV, without re-entering contact or vehicle.
           Outlined, so Submit stays the one filled action on the page. *@
        @if (State.CanAddIssue)
        {
            <MudStack Spacing="1">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           Disabled="_isSubmitting"
                           OnClick="AddIssue"
                           Style="text-transform: none;">Add another issue</MudButton>
                <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
                    Something else wrong with this RV? Add it here. Your contact and vehicle details carry over.
                </MudText>
            </MudStack>
        }
        else
        {
            <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
                You've added @IntakeWizardState.MaxIssues issues, the most one request can hold.
                Call the service team about anything else.
            </MudText>
        }

        @* Submit error *@
        @if (_submitError is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" role="alert">
                @_submitError
                @if (_issueErrors.Count > 0)
                {
                    <ul class="mt-1 mb-0">
                        @foreach (var error in _issueErrors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                }
            </MudAlert>
        }

        @* Upload progress *@
        @if (_uploadProgress is not null)
        {
            <MudStack Spacing="1">
                <MudStack AlignItems="AlignItems.Center" Class="mt-2">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" aria-label="Submitting" />
                </MudStack>
                <MudProgressLinear Color="Color.Primary"
                                   Value="@_uploadProgress.Value"
                                   Max="100"
                                   Rounded="true"
                                   Size="Size.Large"
                                   Class="my-2" />
                <MudText Typo="Typo.body2" Align="Align.Center"
                         Style="color: var(--mud-palette-text-secondary);">
                    @_uploadStatus
                </MudText>
            </MudStack>
        }

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   FullWidth="true"
                   Disabled="_isSubmitting"
                   OnClick="HandleSubmit"
                   Style="text-transform: none;"
                   Class="mt-6">
            @(_isSubmitting ? "Submitting..." : "Submit Service Request")
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired] public IntakeWizardState State { get; set; } = default!;
    [Parameter, EditorRequired] public EventCallback<int> OnEdit { get; set; }

    /// <summary>Edit one issue at a step (5–7): the issue's index, then the step (<c>Spec A-17</c>).</summary>
    [Parameter, EditorRequired] public EventCallback<(int Index, int Step)> OnEditIssue { get; set; }

    /// <summary>Open a blank issue on Step 5 (<c>Spec A-17</c>).</summary>
    [Parameter, EditorRequired] public EventCallback OnAddIssue { get; set; }

    [Parameter, EditorRequired] public EventCallback OnSubmitted { get; set; }
    [Inject] private IntakeApiClient IntakeApi { get; set; } = default!;
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private StatusLinkStore StatusLinks { get; set; } = default!;
    [Inject] private RememberedDetailsStore RememberedDetails { get; set; } = default!;

    private bool _isSubmitting;
    private string? _submitError;
    private string? _uploadStatus;
    private double? _uploadProgress;
    private List<string> _issueErrors = [];

    protected override void OnInitialized()
    {
        // An issue opened with "Add another issue" and then backed out of is not one.
        State.PruneEmptyIssues();
    }

    private async Task EditStep(int step)
    {
        await OnEdit.InvokeAsync(step);
    }

    private Task EditIssue(int index, int step) => OnEditIssue.InvokeAsync((index, step));

    private Task AddIssue() => OnAddIssue.InvokeAsync();

    private async Task RemoveIssue(int index)
    {
        _issueErrors = [];
        _submitError = null;
        await State.RemoveIssueAsync(index);
    }

    private async Task HandleSubmit()
    {
        // An issue added and then left half-done must not reach the API (Spec A-17).
        _issueErrors = State.ValidateAllIssues();
        if (_issueErrors.Count > 0)
        {
            _submitError = "Some issues need more detail before this can be sent:";
            return;
        }

        _isSubmitting = true;
        // Also gates the wizard header's Back button (issue #583): leaving Step 8 while this
        // upload loop is still running would tear down this component's StateHasChanged
        // target mid-submission.
        State.IsSubmitting = true;
        _submitError = null;
        _uploadStatus = null;
        _uploadProgress = null;
        StateHasChanged();

        try
        {
            // The submission carries State.PendingUploadCount so the API knows how many
            // attachments are still coming and defers packet generation until they land
            // (issue #516). The upload loop below must stay in step with that promise —
            // both use the same "buffered but not yet uploaded" predicate.
            var request = State.BuildCreateRequest();
            var result = await IntakeApi.SubmitServiceRequestAsync(State.Slug, request);

            State.IsSubmitted = true;
            State.CreatedServiceRequestId = result.ServiceRequest.Id;
            State.SubmissionMagicLinkToken = result.MagicLinkToken;
            await State.PersistAsync();
            await StatusLinks.SaveAsync(result.MagicLinkToken, result.MagicLinkExpiresAtUtc);

            // Issue #811: only on the customer's say-so, and never on an advisor invite.
            if (State.RememberDetails && State.CanRememberDetails)
            {
                await RememberedDetails.SaveAsync(State.ToRememberedDetails());
            }

            // Spec A-17: each issue's attachments go to its own request, the one at the same
            // position in the response. A response without the id list comes from an API that
            // predates several issues; it created one request, so only one issue can upload.
            var issues = State.GetIssues();
            var uploads = new List<(AttachmentFileInfo File, string ServiceRequestId)>();
            var skippedFiles = new List<AttachmentFileInfo>();
            for (var i = 0; i < issues.Count; i++)
            {
                var targetId = i < result.ServiceRequestIds.Count
                    ? result.ServiceRequestIds[i]
                    : i == 0 ? result.ServiceRequest.Id : null;

                foreach (var attachment in issues[i].Attachments.Where(a => !a.IsUploaded))
                {
                    if (attachment.FileData is null || targetId is null)
                    {
                        skippedFiles.Add(attachment);
                    }
                    else
                    {
                        uploads.Add((attachment, targetId));
                    }
                }
            }

            foreach (var skipped in skippedFiles)
            {
                skipped.ErrorMessage = "File data was not available for upload. Please re-attach the file and try again.";
            }

            var failedUploadCount = skippedFiles.Count;

            if (uploads.Count > 0)
            {
                _uploadProgress = 0;
                _uploadStatus = $"Uploading attachments (0/{uploads.Count})…";
                StateHasChanged();

                for (var i = 0; i < uploads.Count; i++)
                {
                    var (file, serviceRequestId) = uploads[i];
                    _uploadStatus = $"Uploading attachments ({i + 1}/{uploads.Count})…";
                    _uploadProgress = (double)i / uploads.Count * 100;
                    StateHasChanged();

                    try
                    {
                        var sasResponse = await IntakeApi.GetUploadSasAsync(
                            State.Slug, serviceRequestId, file.FileName, file.ContentType);

                        file.BlobName = sasResponse.BlobName;

                        using var content = new ByteArrayContent(file.FileData!);
                        content.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);

                        using var sasRequest = new HttpRequestMessage(HttpMethod.Put, sasResponse.SasUrl);
                        sasRequest.Content = content;
                        sasRequest.Headers.Add("x-ms-blob-type", "BlockBlob");

                        var sasResult = await Http.SendAsync(sasRequest);
                        sasResult.EnsureSuccessStatusCode();

                        await IntakeApi.ConfirmUploadAsync(State.Slug, serviceRequestId, new AttachmentConfirmRequestDto
                        {
                            BlobName = sasResponse.BlobName,
                            FileName = file.FileName,
                            ContentType = file.ContentType,
                            SizeBytes = file.SizeBytes
                        });

                        file.IsUploaded = true;
                    }
                    catch (Exception ex)
                    {
                        file.ErrorMessage = $"Upload failed: {ex.Message}";
                        failedUploadCount++;
                    }
                }

                _uploadProgress = 100;
                StateHasChanged();

                _uploadStatus = null;
                _uploadProgress = null;
            }

            State.FailedUploadCount = failedUploadCount;

            await OnSubmitted.InvokeAsync();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Gone)
        {
            // Spec A-19: the slug expired while the customer was filling the form in.
            _submitError = IntakeUnavailableNotice.Message;
        }
        catch (HttpRequestException ex)
        {
            _submitError = $"Unable to submit your request. Please try again. ({ex.StatusCode})";
        }
        catch (Exception)
        {
            _submitError = "An unexpected error occurred. Please try again.";
        }
        finally
        {
            _isSubmitting = false;
            State.IsSubmitting = false;
            StateHasChanged();
        }
    }

    private string GetNotificationSummary()
    {
        var channels = new List<string>();
        if (!State.EmailOptOut) channels.Add("Email");
        if (!State.SmsOptOut) channels.Add("Text");
        return channels.Count > 0 ? string.Join(" & ", channels) : "None (opted out of all)";
    }
}
