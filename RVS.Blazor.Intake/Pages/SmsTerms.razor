@page "/sms-terms"

@* Linked from the Step 2 texting disclosure (Spec A-2, issue #662). Keep in step with the
   consent script in Docs/Guides/Advisor_Text_Consent_Script.md. *@

<PageTitle>Texting Terms</PageTitle>

<MudStack AlignItems="AlignItems.Center" Class="mt-8">
    <MudPaper Elevation="2" Class="pa-6 rounded-lg" Style="width: 100%; max-width: 640px;">
        <MudStack Spacing="3">
            <MudText Typo="Typo.h5">RV Intake texting terms</MudText>

            <MudText Typo="Typo.body1">
                RV Intake sends text messages on behalf of the RV dealership you are requesting service from.
                We text you only about your own service request: a confirmation when you submit it, and a link
                to start a request if you asked a service advisor to send you one.
            </MudText>

            <MudText Typo="Typo.h6">How often</MudText>
            <MudText Typo="Typo.body1">
                Message frequency varies with your service request. We do not send marketing texts.
            </MudText>

            <MudText Typo="Typo.h6">Cost</MudText>
            <MudText Typo="Typo.body1">
                Message and data rates may apply, depending on your mobile plan.
            </MudText>

            <MudText Typo="Typo.h6">Opting out and help</MudText>
            <MudText Typo="Typo.body1">
                Reply <b>STOP</b> to any message to stop receiving texts. Reply <b>HELP</b> for help.
                You can also tick "Do not send text messages" when you fill in the intake form.
                For anything else, contact the dealership handling your service request.
            </MudText>

            <MudText Typo="Typo.h6">Your number</MudText>
            <MudText Typo="Typo.body1">
                Your mobile number is used only to send the messages described here. It is not sold or
                shared with third parties for marketing.
            </MudText>

            <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
                Carriers are not liable for delayed or undelivered messages.
            </MudText>
        </MudStack>
    </MudPaper>
</MudStack>
