@implements IDisposable
@inject ThemeService ThemeService

@* Policy links on every Intake page (Spec A-15, issue #680). A toll-free verification reviewer
   follows these to connect the filing entity to rvintake.com: the legal name is stated in the
   opening line of each linked policy (issue #470), so the footer itself no longer repeats it.
   The contact email lives at the bottom of each policy document (issue #695).

   "Powered by" the RV Intake mark, centred (Spec A-16, issue #470): on a dealer-branded page it is
   the one place the platform signs its work. *@

<MudDivider Class="mt-8" />
<MudStack AlignItems="AlignItems.Center" Spacing="1" Class="py-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2">
        <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">Powered by</MudText>
        <BrandWordmark Reversed="@ThemeService.IsHighContrast" Height="24px" Title="RV Intake" />
    </MudStack>
    <MudStack Row="true" Justify="Justify.Center" Spacing="3" Wrap="Wrap.Wrap">
        <MudLink Href="/privacy" Typo="Typo.body2">Privacy policy</MudLink>
        <MudLink Href="/terms" Typo="Typo.body2">Terms of use</MudLink>
        <MudLink Href="/sms-terms" Typo="Typo.body2">Texting terms</MudLink>
    </MudStack>
</MudStack>

@code {
    // The mark's colourway follows the page ground: white in the light theme, black in high contrast.
    protected override void OnInitialized() => ThemeService.OnThemeChanged += StateHasChanged;

    public void Dispose() => ThemeService.OnThemeChanged -= StateHasChanged;
}
