# ══════════════════════════════════════════════════════════════════════════════
# RVS Azure Infrastructure — Deployment & Operations Command Reference
# ══════════════════════════════════════════════════════════════════════════════
#
# Scratch/reference file. Copy the block you need; nothing here is meant to be
# run top-to-bottom. Companion docs:
#   - README.md ................. environment model, module map, cost table
#   - PROD_DEPLOYER_SP_SETUP.md . production deployer service principal runbook
#   - ../../../../.github/workflows/README.md . CI deploy workflows + GH secrets
#
# Source of truth for resource config is the Bicep in this folder, not this file.
# The `main.bicep` template is subscription-scoped and deployed with
# `az deployment sub create`, which runs an ARM *incremental* deployment:
# re-running the same template + params is idempotent — unchanged resources are
# left alone, drift is corrected, nothing is deleted. That is why "redeploy after
# a committed .bicep change" (Section 1) is just the same command again.
#
# ──────────────────────────────────────────────────────────────────────────────
# CONTENTS
#   0.  One-time shell setup — subscription + well-known IDs
#   1.  IDEMPOTENT REDEPLOY  ← run after every committed .bicep change
#         1a. Staging
#         1b. Production
#         1c. what-if preview (dry run, optional)
#   2.  First-time / infrequent deploys
#         2a. Resource-group scaffold
#         2b. Production first bring-up — the one-time apex registration
#   3.  SKU upgrades (single-param redeploys)
#   4.  PERMISSIONS / RBAC
#         4a. GitHub Actions OIDC deployer SP — federated creds + Contributor
#         4b. Cross-env DNS Zone Contributor (zone-scoped, least privilege)
#         4c. Developer blob-access group (sg-rvs-dev-blob)
#         4d. Key Vault manual secrets
#         4e. ACS Email send grant (now in Bicep) + post-deploy checks — Issue #489;
#             custom sending domain verification / quota / warming — Issue #532
#   5.  Post-deploy verification
#   6.  SWA deployment tokens → GitHub secrets
#   7.  Misc one-offs
# ──────────────────────────────────────────────────────────────────────────────


# ══════════════════════════════════════════════════════════════════════════════
# 0.  ONE-TIME SHELL SETUP — subscription + well-known IDs
# ══════════════════════════════════════════════════════════════════════════════
# Run once per shell before anything below. All deploy commands assume the
# active subscription is the RVS one and CWD is the repo root.

az login
az account show --query '{name:name, id:id, tenantId:tenantId}' -o json

# Pin the subscription (past deploy output shows this id; confirm with the line
# above before trusting it — it came from an archived dev run):
#   SUBSCRIPTION_ID=4d1d5e99-e872-496d-98be-e8a0a4232aec
SUBSCRIPTION_ID=$(az account show --query id -o tsv)
TENANT_ID=$(az account show --query tenantId -o tsv)
az account set --subscription "$SUBSCRIPTION_ID"

# ── Well-known identifiers (stable; used by Section 4) ────────────────────────
GITHUB_REPO="markarnoldutah/RVS"

# GitHub Actions OIDC deployer service principal (staging + prod, Option A in
# PROD_DEPLOYER_SP_SETUP.md). Display name: github-actions-rvs-deployment
DEPLOYER_APP_ID="de5714f8-924a-4761-b278-9e7a94f2d116"          # app/client id
DEPLOYER_SP_OBJECT_ID="9b1e460a-6bed-418a-9d65-1bbed1f768a9"    # enterprise-app object id

# Built-in role definition GUIDs
ROLE_CONTRIBUTOR="b24988ac-6180-42a0-ab88-20f7382dd24c"
ROLE_DNS_ZONE_CONTRIBUTOR="befefa01-2a29-4197-83a8-272ff33ce314"

# Developer blob-access Entra group (staging only — see 4c)
DEV_BLOB_GROUP="sg-rvs-dev-blob"
DEV_BLOB_GROUP_OBJECT_ID="e7c21157-3e7a-4a31-9408-c4ccef22670e"

# ── Resource groups (2 envs × 3 regions; created by rg-scaffold.bicep) ────────
#   STAGING primary/api  : rg-rvs-staging-westus3
#   STAGING whisper (STT) : rg-rvs-staging-ncus
#   STAGING static web    : rg-rvs-staging-westus2
#   PROD    primary/api   : rg-rvs-prod-westus3
#   PROD    whisper (STT) : rg-rvs-prod-ncus
#   PROD    static web    : rg-rvs-prod-westus2
#
# ── DNS zones (both live in the PROD primary RG, shared across envs) ──────────
#   rvserviceflow.com  → Manager SWA   (manager-staging.* CNAME, manager.* CNAME)
#   rvintake.com       → Intake SWA    (staging.* CNAME in staging; apex ALIAS-A in prod)
#   ...both in rg-rvs-prod-westus3
#
# ── Resource names by environment (from main.bicep name vars / naming-tags) ───
#   kind                staging                              prod
#   ------------------- ------------------------------------ ------------------------------------
#   App Service         app-rvs-api-staging-wus3            app-rvs-api-prod-wus3
#   App Service Plan    asp-rvs-api-staging-wus3            asp-rvs-api-prod-wus3
#   Cosmos DB           cosmos-rvs-data-staging-wus3        cosmos-rvs-data-prod-wus3
#   Key Vault           kv-rvs-staging-wus3                 kv-rvs-prod-wus3
#   Storage account     strvsstagingwus3001                strvsprodwus3001
#   Blob container      rvs-attachments                     rvs-attachments
#   App Insights        appi-rvs-api-staging-wus3           appi-rvs-api-prod-wus3
#   Log Analytics       law-rvs-obs-staging-wus3            law-rvs-obs-prod-wus3
#   OpenAI (GPT-4o)     oai-rvs-ai-staging-wus3-s01-001     oai-rvs-ai-prod-wus3-s01-001
#   OpenAI (Whisper)    oai-rvs-whisper-staging-ncus-s01-001  oai-rvs-whisper-prod-ncus-s01-001
#   Comm. Services      acs-rvs-notify-staging-wus3-s01-001 acs-rvs-notify-prod-wus3-s01-001
#   SWA (Intake)        stapp-rvs-intake-staging            stapp-rvs-intake-prod
#   SWA (Manager)       stapp-rvs-manager-staging           stapp-rvs-manager-prod
#
# prod runs App Service S1 → a deployment slot ("staging") exists and has its own
# managed identity; staging runs B1 → no slot.


# ══════════════════════════════════════════════════════════════════════════════
# 1.  IDEMPOTENT REDEPLOY  ← run after every committed .bicep change
# ══════════════════════════════════════════════════════════════════════════════
# Same command every time. Safe to re-run. `--name` just needs to be unique per
# run (timestamp) so the deployment shows up distinctly in the portal history.
# Note for PowerShell: `$(date ...)` is not expanded — use the PS variant.

# ── 1a. STAGING ──────────────────────────────────────────────────────────────
# bash / zsh
az deployment sub create \
  --location westus3 \
  --template-file Docs/ASOT/Infra/Bicep.IaC/main.bicep \
  --parameters Docs/ASOT/Infra/Bicep.IaC/parameters/staging.bicepparam \
  --name "rvs-staging-$(date +%Y%m%d%H%M)"

# PowerShell
$ts = Get-Date -Format "yyyyMMddHHmm"
az deployment sub create `
  --location westus3 `
  --template-file Docs/ASOT/Infra/Bicep.IaC/main.bicep `
  --parameters Docs/ASOT/Infra/Bicep.IaC/parameters/staging.bicepparam `
  --name "rvs-staging-$ts"

# ── 1b. PRODUCTION ───────────────────────────────────────────────────────────
# One file, prod.bicepparam, first time and every time. It is deployable as
# committed — nothing in it is a placeholder. The very first run also needs the
# one-time apex registration afterwards (Section 2b); redeploys never touch it.
# Auth0 values are passed on the CLI, not stored in the file (Section 4d).
# The ops alert mailbox (#494) is likewise not in the file — append
#   --parameters opsAlertEmailReceivers='[{"name":"oncall","email":"ops@yourco.com"}]'
# (or add receivers to ag-rvs-ops-<env>-wus3 in the portal after the first deploy).
# bash / zsh
az deployment sub create \
  --location westus3 \
  --template-file Docs/ASOT/Infra/Bicep.IaC/main.bicep \
  --parameters Docs/ASOT/Infra/Bicep.IaC/parameters/prod.bicepparam \
  --name "rvs-prod-$(date +%Y%m%d%H%M)"

# PowerShell
$ts = Get-Date -Format "yyyyMMddHHmm"
az deployment sub create `
  --location westus3 `
  --template-file Docs/ASOT/Infra/Bicep.IaC/main.bicep `
  --parameters Docs/ASOT/Infra/Bicep.IaC/parameters/prod.bicepparam `
  --name "rvs-prod-$ts"

# ── 1c. what-if preview (dry run — inspect the change set before committing) ──
# Same args as the deploy, `create` → `what-if`. No `--name` needed.
az deployment sub what-if \
  --location westus3 \
  --template-file Docs/ASOT/Infra/Bicep.IaC/main.bicep \
  --parameters Docs/ASOT/Infra/Bicep.IaC/parameters/staging.bicepparam

az deployment sub what-if \
  --location westus3 \
  --template-file Docs/ASOT/Infra/Bicep.IaC/main.bicep \
  --parameters Docs/ASOT/Infra/Bicep.IaC/parameters/prod.bicepparam


# ══════════════════════════════════════════════════════════════════════════════
# 2.  FIRST-TIME / INFREQUENT DEPLOYS
# ══════════════════════════════════════════════════════════════════════════════

# ── 2a. Resource-group scaffold — creates all 6 RGs in one shot ──────────────
# Idempotent. Run before the first environment deploy; re-run is harmless.
az deployment sub create \
  --location westus3 \
  --template-file Docs/ASOT/Infra/Bicep.IaC/rg-scaffold.bicep \
  --name "rvs-rg-scaffold-$(date +%Y%m%d%H%M)" \
  --query "properties.outputs.resourceGroupNames.value" -o json

# PowerShell
$ts = Get-Date -Format "yyyyMMddHHmm"
az deployment sub create `
  --location westus3 `
  --template-file Docs/ASOT/Infra/Bicep.IaC/rg-scaffold.bicep `
  --name "rvs-rg-scaffold-$ts"

# ── 2b. PRODUCTION first bring-up — the one-time apex registration ───────────
# Full narrative with the portal path: README.md "Deploy Production". Summary:
#
#   Bicep (Section 1b) creates everything, binds manager.rvserviceflow.com, and
#   writes an ALIAS A record at the rvintake.com apex → Intake SWA. Azure DNS
#   tracks the SWA's address itself, so no IP is pinned anywhere.
#
#   What Bicep deliberately does NOT do is *register* the apex with the SWA:
#   Azure mints the TXT ownership token at registration time, so it cannot be
#   authored in a param file — which is exactly what the old prod_phase2
#   placeholders were trying (and failing) to do. Register once, by hand, after
#   the first Section 1b run. Incremental redeploys leave it alone forever.
#
# Easiest: Portal → stapp-rvs-intake-prod → Settings → Custom domains → + Add
#          → "Custom Domain on Azure DNS" → zone rvintake.com → Add. Azure writes
#          the TXT, confirms the ALIAS, validates. Wait for Status = Ready.
#
# CLI equivalent (NOTE: the command is `hostname set`; `hostname add` does not
# exist. NOTE: prod Intake SWA lives in rg-rvs-prod-westus2, the zone in
# rg-rvs-prod-westus3):

# 1. Register. --no-wait because the operation blocks until the TXT validates,
#    and the TXT does not exist yet.
az staticwebapp hostname set \
  --name stapp-rvs-intake-prod \
  --resource-group rg-rvs-prod-westus2 \
  --hostname rvintake.com \
  --validation-method dns-txt-token \
  --no-wait

# 2. Read the token. This is the only value `hostname show` returns — it has no
#    IP-address field, and none is needed with the ALIAS record.
TOKEN=$(az staticwebapp hostname show \
  --name stapp-rvs-intake-prod \
  --resource-group rg-rvs-prod-westus2 \
  --hostname rvintake.com \
  --query validationToken -o tsv)
echo "$TOKEN"

# 3. Publish the token at the apex.
az network dns record-set txt add-record \
  --resource-group rg-rvs-prod-westus3 \
  --zone-name rvintake.com \
  --record-set-name @ \
  --value "$TOKEN"

# 4. Poll until status = Ready (minutes — the zone is on Azure DNS, so the
#    "up to 72 h" in Microsoft's doc does not apply in practice).
az staticwebapp hostname show \
  --name stapp-rvs-intake-prod \
  --resource-group rg-rvs-prod-westus2 \
  --hostname rvintake.com \
  --query '{status:status, error:errorMessage}' -o json

# 5. Verify end to end.
dig +short rvintake.com A
az staticwebapp hostname list --name stapp-rvs-intake-prod  --resource-group rg-rvs-prod-westus2 -o table
az staticwebapp hostname list --name stapp-rvs-manager-prod --resource-group rg-rvs-prod-westus2 -o table


# ══════════════════════════════════════════════════════════════════════════════
# 3.  SKU UPGRADES — change one param on the CLI, redeploy
# ══════════════════════════════════════════════════════════════════════════════
# A trailing `--parameters key=value` overrides the value in the .bicepparam
# file for that run only. To make it permanent, edit the .bicepparam and use a
# plain Section 1 redeploy instead.

# App Service  B1 → S1 (staging). Enables Always On + deployment slots.
az deployment sub create \
  --location westus3 \
  --template-file Docs/ASOT/Infra/Bicep.IaC/main.bicep \
  --parameters Docs/ASOT/Infra/Bicep.IaC/parameters/staging.bicepparam \
  --parameters appServiceSkuName='S1' \
  --name "rvs-staging-sku-$(date +%Y%m%d%H%M)"

# Cosmos DB  Serverless → Provisioned autoscale (prod).
# WARNING: Serverless → Provisioned requires account recreation. Back up first.
az deployment sub create \
  --location westus3 \
  --template-file Docs/ASOT/Infra/Bicep.IaC/main.bicep \
  --parameters Docs/ASOT/Infra/Bicep.IaC/parameters/prod.bicepparam \
  --parameters cosmosCapacityMode='Provisioned' cosmosAutoscaleMaxThroughput=4000 \
  --name "rvs-prod-cosmos-$(date +%Y%m%d%H%M)"

# SWA  Free → Standard (staging). Standard is already the default in the param
# files; this is only for an env that was pinned to Free.
az deployment sub create \
  --location westus3 \
  --template-file Docs/ASOT/Infra/Bicep.IaC/main.bicep \
  --parameters Docs/ASOT/Infra/Bicep.IaC/parameters/staging.bicepparam \
  --parameters swaSkuName='Standard' \
  --name "rvs-staging-swa-$(date +%Y%m%d%H%M)"


# ══════════════════════════════════════════════════════════════════════════════
# 4.  PERMISSIONS / RBAC
# ══════════════════════════════════════════════════════════════════════════════
# Requires Owner or User Access Administrator on the target scope. Run the
# Section 0 setup block first (SUBSCRIPTION_ID, DEPLOYER_APP_ID, role GUIDs …).

# ── 4a. GitHub Actions OIDC deployer SP — federated creds + Contributor ──────
# Full runbook (incl. Option B = separate prod SP): PROD_DEPLOYER_SP_SETUP.md
# and ../../../../.github/workflows/README.md. The SP already exists for staging;
# these commands ADD the production environment to the same SP (Option A).

# Federated credential for the GitHub `production` environment
az ad app federated-credential create \
  --id "$DEPLOYER_APP_ID" \
  --parameters '{
    "name": "github-actions-production",
    "issuer": "https://token.actions.githubusercontent.com",
    "subject": "repo:markarnoldutah/RVS:environment:production",
    "audiences": ["api://AzureADTokenExchange"]
  }'

# Verify both environments are wired (expect github-actions-staging + -production)
az ad app federated-credential list --id "$DEPLOYER_APP_ID" \
  --query '[].{name:name, subject:subject}' -o table

# Contributor on each production resource group (staging RGs were granted at
# staging setup time). main.bicep is subscription-scoped but only writes into
# these RGs, so RG-scoped Contributor is sufficient.
for RG in rg-rvs-prod-westus3 rg-rvs-prod-ncus rg-rvs-prod-westus2; do
  az role assignment create \
    --assignee "$DEPLOYER_APP_ID" \
    --role "$ROLE_CONTRIBUTOR" \
    --scope "/subscriptions/$SUBSCRIPTION_ID/resourceGroups/$RG"
done

# List what the deployer SP currently holds
az role assignment list --assignee "$DEPLOYER_APP_ID" --all \
  --query '[].{role:roleDefinitionName, scope:scope}' -o table

# ── 4b. Cross-env DNS Zone Contributor (zone-scoped, least privilege) ────────
# Both DNS zones live in rg-rvs-prod-westus3. The staging deploy writes CNAMEs
# (staging.rvintake.com, manager-staging.rvserviceflow.com) into them, so the
# staging deployer SP needs write access to the ZONES ONLY — never RG-wide
# Contributor on the prod RG.
#
# This grant is normally made BY Bicep: dnsZoneContributorPrincipalIds in
# prod.bicepparam already contains the deployer SP object id
# ($DEPLOYER_SP_OBJECT_ID), and modules/dns-zone-contributor.bicep creates the
# assignment at zone scope during a prod deploy. The manual equivalent:

for ZONE in rvintake.com rvserviceflow.com; do
  ZONE_ID=$(az network dns zone show \
    --name "$ZONE" --resource-group rg-rvs-prod-westus3 --query id -o tsv)
  az role assignment create \
    --assignee "$DEPLOYER_SP_OBJECT_ID" \
    --role "$ROLE_DNS_ZONE_CONTRIBUTOR" \
    --scope "$ZONE_ID"
done

# Verify (run after a prod deploy or the loop above)
for ZONE in rvintake.com rvserviceflow.com; do
  ZONE_ID=$(az network dns zone show \
    --name "$ZONE" --resource-group rg-rvs-prod-westus3 --query id -o tsv)
  echo "== $ZONE =="
  az role assignment list --scope "$ZONE_ID" \
    --query '[].{principal:principalName, role:roleDefinitionName}' -o table
done

# ── 4c. Developer blob-access group (staging storage only) ──────────────────
# Local API runs authenticate to Blob as the developer's own Entra identity
# (AzureCliCredential), so devs need data-plane roles on the staging storage
# account. Grant them via the sg-rvs-dev-blob group and manage access by
# membership — no redeploy. The role assignments themselves are created by
# Bicep when devBlobAccessPrincipalId is set in staging.bicepparam (it is:
# $DEV_BLOB_GROUP_OBJECT_ID). PROD leaves this unset by design (JIT/PIM only).

# One-time group creation (already done — object id is in Section 0)
az ad group create --display-name "$DEV_BLOB_GROUP" --mail-nickname "$DEV_BLOB_GROUP"
az ad group show --group "$DEV_BLOB_GROUP" --query id -o tsv

# Add / remove a developer
az ad group member add    --group "$DEV_BLOB_GROUP" --member-id <user-object-id>
az ad group member remove --group "$DEV_BLOB_GROUP" --member-id <user-object-id>
az ad group member list   --group "$DEV_BLOB_GROUP" --query '[].{name:displayName, upn:userPrincipalName}' -o table

# ── 4d. Key Vault manual secrets ────────────────────────────────────────────
# OpenAI / ACS / App Insights / Cosmos secrets are written by Bicep. Stripe is
# the only one added by hand, per environment.
az keyvault secret set --vault-name kv-rvs-staging-wus3 \
  --name "Stripe--WebhookSecret" --value "<YOUR_STRIPE_WEBHOOK_SECRET>"
az keyvault secret set --vault-name kv-rvs-prod-wus3 \
  --name "Stripe--WebhookSecret" --value "<YOUR_STRIPE_WEBHOOK_SECRET>"

# ── 4e. ACS Email send grant + enablement checks — Issue #489 ───────────────
# ┌────────────────────────────────────────────────────────────────────────────┐
# │ The RBAC grant and the sender-address config are now BICEP (shipped with   │
# │ #489):                                                                     │
# │   - modules/communication-services.bicep grants the API managed identity   │
# │     (and the S1 staging-slot identity) Contributor ON THE ACS RESOURCE,    │
# │     wired from main.bicep like the Key Vault / Storage grants.             │
# │   - modules/app-service-config.bicep sets the app setting                  │
# │     AzureCommunicationServices__Email__FromAddress =                       │
# │     DoNotReply@<communicationServices.outputs.azureManagedMailFrom>,       │
# │     so the hardcoded DoNotReply@<guid>.azurecomm.net is gone from          │
# │     RVS.API/appsettings.json.                                              │
# │ So a plain Section 1 redeploy applies both. The commands below are the     │
# │ manual fallback (grant not yet propagated, or applying to an env whose     │
# │ Bicep pre-dates #489) plus the post-deploy checks that CANNOT be Bicep.    │
# └────────────────────────────────────────────────────────────────────────────┘
#
# Why the grant is needed: AcsEmailNotificationService authenticates to ACS with
# the API's system-assigned managed identity (DefaultAzureCredential). Before
# #489 that identity held roles for Key Vault + Storage only — none on the ACS
# resource — so EmailClient.SendAsync returned 403. ACS has no granular "email
# sender" data-plane role as of writing; the documented minimum is Contributor
# scoped to the ACS resource. Re-check the current ACS "authenticate with managed
# identity" docs periodically in case a narrower role appears.

# ── (0) Redeploy — applies the Bicep grant + sender-address app setting ──────
# STAGING: Section 1a.  PROD: Section 1b.

# ── (1) MANUAL FALLBACK — grant Contributor on the ACS resource by hand ─────
# Only if the Bicep grant has not propagated or the target env's Bicep is older.
# Run the Section 0 setup block first ($ROLE_CONTRIBUTOR etc.).

# STAGING (API on B1 — primary identity only):
ACS_ID=$(az communication show \
  --name acs-rvs-notify-staging-wus3-s01-001 \
  --resource-group rg-rvs-staging-westus3 --query id -o tsv)
API_MI=$(az webapp show \
  --name app-rvs-api-staging-wus3 \
  --resource-group rg-rvs-staging-westus3 --query identity.principalId -o tsv)
az role assignment create \
  --assignee "$API_MI" --role "$ROLE_CONTRIBUTOR" --scope "$ACS_ID"

# PROD (API on S1 — also grant the deployment-slot identity):
ACS_ID=$(az communication show \
  --name acs-rvs-notify-prod-wus3-s01-001 \
  --resource-group rg-rvs-prod-westus3 --query id -o tsv)
API_MI=$(az webapp show \
  --name app-rvs-api-prod-wus3 \
  --resource-group rg-rvs-prod-westus3 --query identity.principalId -o tsv)
SLOT_MI=$(az webapp identity show \
  --name app-rvs-api-prod-wus3 --slot staging \
  --resource-group rg-rvs-prod-westus3 --query principalId -o tsv)
az role assignment create --assignee "$API_MI"  --role "$ROLE_CONTRIBUTOR" --scope "$ACS_ID"
az role assignment create --assignee "$SLOT_MI" --role "$ROLE_CONTRIBUTOR" --scope "$ACS_ID"

# Verify the grant (expect Contributor for the API MI, + the slot MI in prod):
az role assignment list --scope "$ACS_ID" \
  --query '[].{principal:principalId, role:roleDefinitionName}' -o table

# ── (2) POST-DEPLOY CHECKS — not expressible in Bicep ───────────────────────

# (a) Managed domain provisioned + verified (AzureManaged verification can lag a
#     few minutes; sends fail with DomainNotLinked until it is Succeeded):
az communication email domain show \
  --domain-name AzureManagedDomain \
  --email-service-name acs-rvs-notify-staging-wus3-s01-001-email \
  --resource-group rg-rvs-staging-westus3 \
  --query '{state:properties.provisioningState, verification:properties.verificationStates}' -o json

# (b) Read back the real sender domain and confirm the deployed app setting
#     matches DoNotReply@<domain>. Staging and prod send From their custom domain
#     (#532); use --domain-name AzureManagedDomain for an env without one:
az communication email domain show \
  --domain-name mail.staging.rvintake.com \
  --email-service-name acs-rvs-notify-staging-wus3-s01-001-email \
  --resource-group rg-rvs-staging-westus3 \
  --query 'properties.fromSenderDomain' -o tsv
az webapp config appsettings list \
  --name app-rvs-api-staging-wus3 --resource-group rg-rvs-staging-westus3 \
  --query "[?name=='AzureCommunicationServices__Email__FromAddress'].value" -o tsv

# (c) ACS email send quota + custom sending domains — issue #532.
#     Both environments set acsCustomEmailDomain, each on its OWN ACS resource:
#       STAGING → mail.staging.rvintake.com     PROD → mail.rvintake.com
#     Bicep provisions a CustomerManaged domain and writes its SPF (-all) / DKIM /
#     DKIM2 / domain-ownership records + a DMARC p=none record into the rvintake.com
#     zone. The Azure-managed domain stays linked as a fallback only (5 emails/min,
#     10/hour — NOT raisable). The steps below (prod names) are the data-plane work
#     Bicep cannot do — the `acsCustomDomainAction` deployment output repeats the
#     summary.
#
#     STAGING runs steps 1–3 only — no quota request (the default 100/hour covers
#     testing) and no warming — with the domain mail.staging.rvintake.com, DMARC host
#     _dmarc.mail.staging.rvintake.com, and:
#       ACS_EMAIL_SVC=acs-rvs-notify-staging-wus3-s01-001-email
#       ACS_RG=rg-rvs-staging-westus3
#     The rvintake.com zone lives in rg-rvs-prod-westus3 in both cases — use that RG
#     for the `az network dns record-set list` in step 1.
#
#     ACS_EMAIL_SVC=acs-rvs-notify-prod-wus3-s01-001-email   # <acs>-email
#     ACS_RG=rg-rvs-prod-westus3
#
#     1. Confirm the zone records match what ACS expects (they should — Bicep wrote
#        them from this same source):
#          az communication email domain show \
#            --domain-name mail.rvintake.com --email-service-name "$ACS_EMAIL_SVC" \
#            -g "$ACS_RG" --query 'properties.verificationRecords' -o jsonc
#          az network dns record-set list -g "$ACS_RG" -z rvintake.com \
#            --query "[?contains(name,'mail') || contains(name,'_dmarc')].{n:name,t:type}" -o table
#
#     2. Initiate verification for each record type, then poll verificationStates:
#          for t in Domain SPF DKIM DKIM2; do
#            az communication email domain initiate-verification \
#              --domain-name mail.rvintake.com --email-service-name "$ACS_EMAIL_SVC" \
#              -g "$ACS_RG" --verification-type $t
#          done
#          az communication email domain show \
#            --domain-name mail.rvintake.com --email-service-name "$ACS_EMAIL_SVC" \
#            -g "$ACS_RG" --query 'properties.verificationStates' -o jsonc
#        Every entry must read "Verified". Sends From mail.rvintake.com fail until
#        then; the Azure-managed domain stays linked as a fallback.
#
#     3. Confirm DMARC resolves and the reporting mailbox is monitored:
#          dig +short TXT _dmarc.mail.rvintake.com
#          # → v=DMARC1; p=none; rua=mailto:dmarc-reports@rvserviceflow.com
#
#     4. THEN request the ACS send-quota increase — Portal → ACS → Email → Domains →
#        mail.rvintake.com → quota request (or Help+Support → Service and Subscription
#        Limits (Quotas)). Approval takes up to 72 HOURS, longer if filed on a Friday,
#        and requires a sustained bounce rate under 1%. Do NOT schedule a pilot launch
#        inside that window.
#
#     5. Warm the domain: let Jay Lyons's real intake traffic (P1, #525) send through
#        mail.rvintake.com for 2–3 WEEKS before any other shop's mailbox gets a packet.
#        Ramp gradually; watch ACS delivery/bounce metrics and the DMARC rua reports.
#        Sustained ACS failures above ~1% risk throttling.
#
#     6. In-room deliverability check (second pilot onward — FS-7 in RVS_Plan.md):
#        send a test packet with the service manager present, confirm inbox not Junk,
#        have them mark the sender safe on the spot. Not needed for the first pilot.

# (d) Point at least one staging Location's packetConfig.recipients at a REAL
#     mailbox you control (seed data uses RFC 2606 .example.com addresses that
#     hard-bounce). packetConfig.enabled already defaults to true.
#       PUT /api/dealers/{dealerId}/locations/{locationId}   (body: packetConfig.recipients)
#     or edit the locations container directly in Cosmos.

# (e) End-to-end: complete a staging intake, then in App Insights expect
#     "ACS packet email send initiated ..." (info) from AcsEmailNotificationService.
#     A failure logs "Packet email dispatch failed ..." (error) from
#     PacketGenerationService and is otherwise swallowed (retry/idempotency = #438).
#     Confirm the mail arrives with the PDF + photo attachments, subject
#     "[RVS] {category} — {year} {make} {model} — {customer last name}".

# ── 4f. Preliminary-assessment GPT-5 deployment — Issue #584 ────────────────
# ┌────────────────────────────────────────────────────────────────────────────┐
# │ Fully Bicep-driven — a plain Section 1 redeploy applies all of it:         │
# │   - modules/openai.bicep gains a second, independent model deployment     │
# │     (name = assessmentModelName, default "gpt-5") on the SAME OpenAI      │
# │     account as gpt-4o, via additionalDeployments. gpt-4o is untouched.    │
# │   - modules/openai-keyvault-secrets.bicep writes                          │
# │     AzureOpenAi--AssessmentDeploymentName with that name (empty when      │
# │     assessmentModelName is blank).                                        │
# │   - Program.cs reads that secret first for the packet preliminary         │
# │     assessment only; categorization/issue-text refinement stay on        │
# │     TextDeploymentName (gpt-4o) unchanged.                                │
# │ SKU is DataZoneStandard (US) — gpt-5 is not offered under the regional    │
# │ Standard SKU gpt-4o uses. Capacity: staging.bicepparam = 1 K TPM,          │
# │ prod(_basic).bicepparam = 2 K TPM — both confirmed against remaining      │
# │ subscription quota for gpt-5 in westus3 at the time these were set;       │
# │ re-check before raising (Section 0 below).                                │
# └────────────────────────────────────────────────────────────────────────────┘
#
# ── (0) Redeploy — creates the gpt-5 deployment + the KV secret ─────────────
# STAGING: Section 1a.  PROD: Section 1b.  Preview first with Section 1c
# what-if — expect ONE new Microsoft.CognitiveServices/accounts/deployments
# resource and ONE new/changed Key Vault secret; no change to the gpt-4o
# deployment or its capacity.

# ── (1) Confirm quota BEFORE deploying (repeat per environment/region) ──────
# "maxCapacity" is what Azure will actually let you allocate right now, not
# the model's theoretical ceiling — raise assessmentDeploymentCapacity above
# it and the deployment fails.
az cognitiveservices account list-models \
  --name oai-rvs-ai-staging-wus3-s01-001 --resource-group rg-rvs-staging-westus3 \
  --query "[?name=='gpt-5'].{version:version, maxCapacity:maxCapacity}" -o table

# ── (2) POST-DEPLOY CHECKS ───────────────────────────────────────────────────

# (a) The gpt-5 deployment exists with the expected capacity:
az cognitiveservices account deployment show \
  --name oai-rvs-ai-staging-wus3-s01-001 --resource-group rg-rvs-staging-westus3 \
  --deployment-name gpt-5 \
  --query '{model:properties.model, sku:sku}' -o json

# (b) The Key Vault secret resolves to that deployment name (uses the API's
#     managed identity in staging/prod — az keyvault secret show works too if
#     your own principal has Key Vault Secrets Officer/User on the vault):
az keyvault secret show \
  --vault-name kv-rvs-staging-wus3 \
  --name AzureOpenAi--AssessmentDeploymentName --query value -o tsv

# (c) Smoke-test: dotnet run --project RVS.PacketDump against a config pointed
#     at staging, comparing gpt-4o vs gpt-5 output on a few sample packets —
#     confirm the request contract (temperature, max_tokens, response_format:
#     json_object) still works for gpt-5 at the pinned ApiVersion in
#     AzureOpenAiPreliminaryAssessmentService.cs. If it doesn't, the service's
#     existing fallback silently degrades to the rule-based assessment rather
#     than erroring — watch App Insights for repeated "falling back to
#     rule-based" warnings from AzureOpenAiPreliminaryAssessmentService, which
#     is the symptom of a contract mismatch, not a crash.

# (d) REVERT to gpt-4o for the assessment call (no application-code change):
#     set `assessmentModelName = ''` in the environment's .bicepparam file and
#     redeploy (Section 0). The idle gpt-5 deployment can be left in place —
#     PAYG capacity is a rate-limit ceiling, not a reservation cost — or
#     removed with:
#       az cognitiveservices account deployment delete \
#         --name oai-rvs-ai-staging-wus3-s01-001 \
#         --resource-group rg-rvs-staging-westus3 --deployment-name gpt-5


# ══════════════════════════════════════════════════════════════════════════════
# 5.  POST-DEPLOY VERIFICATION
# ══════════════════════════════════════════════════════════════════════════════
# Shown for STAGING. For prod, swap: rg-rvs-staging-westus3 → rg-rvs-prod-westus3,
# rg-rvs-staging-westus2 → rg-rvs-prod-westus2, and -staging- → -prod- in names.

# App Service — state + managed identity principal id
az webapp show --name app-rvs-api-staging-wus3 --resource-group rg-rvs-staging-westus3 \
  --query '{name:name, state:state, identity:identity.principalId, host:defaultHostName}' -o json

# API health endpoint
curl -fsS https://app-rvs-api-staging-wus3.azurewebsites.net/health

# Cosmos DB — endpoint + capabilities (expect EnableServerless)
az cosmosdb show --name cosmos-rvs-data-staging-wus3 --resource-group rg-rvs-staging-westus3 \
  --query '{name:name, endpoint:documentEndpoint, capabilities:capabilities[].name}' -o json

# Key Vault — RBAC model enabled
az keyvault show --name kv-rvs-staging-wus3 --resource-group rg-rvs-staging-westus3 \
  --query '{name:name, vaultUri:properties.vaultUri, rbac:properties.enableRbacAuthorization}' -o json

# Key Vault — secrets present (OpenAi--*, AzureCommunicationServices--*, etc.)
az keyvault secret list --vault-name kv-rvs-staging-wus3 --query '[].name' -o tsv

# Storage — rvs-attachments container exists
az storage container show --name rvs-attachments --account-name strvsstagingwus3001 \
  --auth-mode login --query '{name:name, publicAccess:properties.publicAccess}' -o json

# Application Insights — connection string
az monitor app-insights component show --app appi-rvs-api-staging-wus3 \
  --resource-group rg-rvs-staging-westus3 --query '{name:name, connectionString:connectionString}' -o json

# Log Analytics workspace
az monitor log-analytics workspace show --workspace-name law-rvs-obs-staging-wus3 \
  --resource-group rg-rvs-staging-westus3 --query '{name:name, customerId:customerId}' -o json

# Packet-pipeline alerts (#494) — ops action group + its receivers, and the 5 rules.
# opsAlertEmailReceivers is empty in the param files; set it on the deploy:
#   --parameters opsAlertEmailReceivers='[{"name":"oncall","email":"ops@yourco.com"}]'
# or add receivers to the action group here. Empty group = alerts fire but page nobody.
az monitor action-group show --name ag-rvs-ops-staging-wus3 \
  --resource-group rg-rvs-staging-westus3 \
  --query '{name:name, shortName:groupShortName, enabled:enabled, email:emailReceivers[].emailAddress}' -o json
az monitor scheduled-query list --resource-group rg-rvs-staging-westus3 \
  --query "[?starts_with(name,'sqr-rvs-packet-')].{name:name, sev:severity, enabled:enabled, freq:evaluationFrequency, window:windowSize}" -o table
# Prove the alert query has data to project (run in the App Insights Logs blade or via CLI):
#   union traces, exceptions
#   | where tostring(customDimensions.EventId) in ("439002","438001","434001","521001","439001")
#   | project timestamp, customDimensions.EventId, SeverityLevel,
#             LocationId=tostring(customDimensions.LocationId),
#             ServiceRequestId=tostring(customDimensions.ServiceRequestId),
#             TenantId=tostring(customDimensions.TenantId)

# Azure OpenAI — endpoint + model deployments
az cognitiveservices account show --name oai-rvs-ai-staging-wus3-s01-001 \
  --resource-group rg-rvs-staging-westus3 --query '{name:name, endpoint:properties.endpoint}' -o json
az cognitiveservices account deployment list --name oai-rvs-ai-staging-wus3-s01-001 \
  --resource-group rg-rvs-staging-westus3 --query '[].{name:name, model:properties.model.name}' -o table
# Whisper is a separate account in northcentralus:
az cognitiveservices account deployment list --name oai-rvs-whisper-staging-ncus-s01-001 \
  --resource-group rg-rvs-staging-ncus --query '[].{name:name, model:properties.model.name}' -o table

# Communication Services — host name
az communication show --name acs-rvs-notify-staging-wus3-s01-001 \
  --resource-group rg-rvs-staging-westus3 --query '{name:name, hostName:hostName}' -o json

# DNS — zone name servers (delegation check; zones are in the PROD RG)
az network dns zone show --name rvserviceflow.com --resource-group rg-rvs-prod-westus3 \
  --query nameServers -o table
az network dns zone show --name rvintake.com --resource-group rg-rvs-prod-westus3 \
  --query nameServers -o table

# Deployment history / failures for a run
az deployment sub list --query "[?starts_with(name,'rvs-staging')].{name:name, state:properties.provisioningState, ts:properties.timestamp}" -o table
az deployment operation sub list --name "rvs-staging-<timestamp>" \
  --query "[?properties.provisioningState=='Failed'].{res:properties.targetResource.resourceName, status:properties.statusMessage}" -o json


# ══════════════════════════════════════════════════════════════════════════════
# 6.  SWA DEPLOYMENT TOKENS → GITHUB SECRETS
# ══════════════════════════════════════════════════════════════════════════════
# Static Web Apps deploy from CI with a long-lived deployment token (not OIDC).
# Rotate into GitHub whenever the SWA is recreated. Canonical secret names
# (see .github/workflows): INTAKE_SWA_TOKEN_{STAGING,PRODUCTION},
# MANAGER_SWA_TOKEN_{STAGING,PRODUCTION}.

# ── Staging (SWAs in rg-rvs-staging-westus2) ────────────────────────────────
az staticwebapp secrets list --name stapp-rvs-intake-staging \
  --resource-group rg-rvs-staging-westus2 --query "properties.apiKey" -o tsv
az staticwebapp secrets list --name stapp-rvs-manager-staging \
  --resource-group rg-rvs-staging-westus2 --query "properties.apiKey" -o tsv

gh secret set INTAKE_SWA_TOKEN_STAGING --env staging --repo "$GITHUB_REPO" --body "$(
  az staticwebapp secrets list --name stapp-rvs-intake-staging \
    --resource-group rg-rvs-staging-westus2 --query 'properties.apiKey' -o tsv)"
gh secret set MANAGER_SWA_TOKEN_STAGING --env staging --repo "$GITHUB_REPO" --body "$(
  az staticwebapp secrets list --name stapp-rvs-manager-staging \
    --resource-group rg-rvs-staging-westus2 --query 'properties.apiKey' -o tsv)"

# ── Production (SWAs in rg-rvs-prod-westus2) ────────────────────────────────
az staticwebapp secrets list --name stapp-rvs-intake-prod \
  --resource-group rg-rvs-prod-westus2 --query "properties.apiKey" -o tsv
az staticwebapp secrets list --name stapp-rvs-manager-prod \
  --resource-group rg-rvs-prod-westus2 --query "properties.apiKey" -o tsv

gh secret set INTAKE_SWA_TOKEN_PRODUCTION --env production --repo "$GITHUB_REPO" --body "$(
  az staticwebapp secrets list --name stapp-rvs-intake-prod \
    --resource-group rg-rvs-prod-westus2 --query 'properties.apiKey' -o tsv)"
gh secret set MANAGER_SWA_TOKEN_PRODUCTION --env production --repo "$GITHUB_REPO" --body "$(
  az staticwebapp secrets list --name stapp-rvs-manager-prod \
    --resource-group rg-rvs-prod-westus2 --query 'properties.apiKey' -o tsv)"


# ══════════════════════════════════════════════════════════════════════════════
# 7.  MISC ONE-OFFS
# ══════════════════════════════════════════════════════════════════════════════

# Pin the App Service .NET runtime (if a deploy resets it)
az webapp config set --resource-group rg-rvs-staging-westus3 \
  --name app-rvs-api-staging-wus3 --dotnet-version "v10.0"

# Register the resource providers main.bicep needs (once per subscription)
for NS in Microsoft.CognitiveServices Microsoft.Communication Microsoft.DocumentDB \
          Microsoft.Web Microsoft.KeyVault Microsoft.OperationalInsights Microsoft.Insights; do
  az provider register --namespace "$NS"
done

# Upgrade the local Bicep CLI (bundled with az)
az bicep upgrade

# Tail live App Service logs
az webapp log tail --name app-rvs-api-staging-wus3 --resource-group rg-rvs-staging-westus3
