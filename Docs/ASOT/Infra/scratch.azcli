az staticwebapp hostname delete \
  -n stapp-rvs-manager-prod -g rg-rvs-prod-westus2 \
  --hostname manager.rvintake.com --yes

# confirm it's gone (only manager.rvserviceflow.com should remain)
az staticwebapp hostname list -n stapp-rvs-manager-prod -g rg-rvs-prod-westus2 \
  --query "[].{host:name,status:status}" -o table

  az staticwebapp hostname set \
  -n stapp-rvs-manager-prod -g rg-rvs-prod-westus2 \
  --hostname manager.rvintake.com --validation-method cname-delegation

  az staticwebapp hostname list -n stapp-rvs-manager-prod -g rg-rvs-prod-westus2 \
  --query "[?name=='manager.rvintake.com'].{host:name,status:status,err:errorMessage}" -o table





APP=app-rvs-api-prod-wus3
RG=rg-rvs-prod-westus3
API_HOST=api.rvserviceflow.com
# NOT "HOST" — zsh built-in

dig +short CNAME "$API_HOST"
dig +short TXT "asuid.api.rvserviceflow.com"

az webapp config hostname add --webapp-name "$APP" -g "$RG" --hostname "$API_HOST"
az webapp config ssl create   --name "$APP" -g "$RG" --hostname "$API_HOST"

# confirm cert exists before moving on
az resource list --resource-type Microsoft.Web/certificates -g "$RG" -o table

az webapp config hostname delete --webapp-name "$APP" -g "$RG" --hostname "$API_HOST"
sleep 30
az webapp config hostname add    --webapp-name "$APP" -g "$RG" --hostname "$API_HOST"
az webapp config ssl create      --name "$APP" -g "$RG" --hostname "$API_HOST"



THUMB=$(az resource show --resource-type Microsoft.Web/certificates -n "$API_HOST" -g "$RG" --query properties.thumbprint -o tsv)
echo "$THUMB"   # must be non-empty

az webapp config ssl bind --name "$APP" -g "$RG" \
  --certificate-thumbprint "$THUMB" --ssl-type SNI

echo | openssl s_client -connect "$API_HOST:443" -servername "$API_HOST" 2>/dev/null \
  | openssl x509 -noout -subject          # must print CN=api-staging.rvserviceflow.com
curl -sS "https://$API_HOST/health"

