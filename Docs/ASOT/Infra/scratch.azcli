az network dns record-set list -g rg-rvs-prod-westus3 -z rvintake.com \
  --query "[?contains(name,'mail-staging')].{name:name,type:type}" -o table
# Expect five: mail-staging (TXT), _dmarc.mail-staging (TXT), 
# and two DKIM CNAMEs, plus whatever selector naming ACS returns.

SVC=acs-rvs-notify-staging-wus3-s01-001-email
RG=rg-rvs-staging-westus3
DOM=mail-staging.rvintake.com

az communication email domain show \
  --domain-name "$DOM" --email-service-name "$SVC" -g "$RG" \
  --query verificationRecords -o json


for t in Domain SPF DKIM DKIM2; do
  az communication email domain initiate-verification \
    --domain-name "$DOM" \
    --email-service-name "$SVC" -g "$RG" \
    --verification-type $t
done

az communication show -n acs-rvs-notify-staging-wus3-s01-001 -g rg-rvs-staging-westus3 \
  --query linkedDomains -o tsv

