# The single Auth0 tenant that dev, staging and production share for now (#610).
# When environments split, add dev.env / staging.env / prod.env next to this file
# (copy _template.env) and point each at its own tenant and vault.

AUTH0_TENANT_NAME=shared
AUTH0_DOMAIN=dev-2jhzz8xmjggh26pm.us.auth0.com

# Where the Management API M2M credentials live: ${PREFIX}--Domain, --ClientId, --ClientSecret.
# The shared tenant keeps them in the staging vault. Note RVS.API loads every secret
# in its vault into configuration, so the staging API process can see these values.
AUTH0_MGMT_KEYVAULT=kv-rvs-staging-wus3
AUTH0_MGMT_SECRET_PREFIX=Auth0Mgmt

# ── Used by auth0-apply.sh ──────────────────────────────────────────────────────

AUTH0_API_IDENTIFIER=https://api.rvserviceflow.com

# The OIDC authority the BROWSER apps use. Leave unset while the tenant has no custom
# domain — it then defaults to https://$AUTH0_DOMAIN/. Once the Auth0 custom domain is
# live (Auth0 checklist §6) set it to https://login.rvintake.com/ and leave AUTH0_DOMAIN
# on the canonical .us.auth0.com host: that is where the Management API lives, and lib.sh
# fails the run if it disagrees with the vault's ${AUTH0_MGMT_SECRET_PREFIX}--Domain.
# auth0-apply.sh checks the Manager appsettings against THIS value, not AUTH0_DOMAIN.
AUTH0_APP_AUTHORITY=https://login.rvintake.com/

# ── Checked by auth0-apply.sh, never applied ─────────────────────────────────────
# Tenant-wide settings RVS sets by hand in the dashboard (Auth0 checklist §6-§8). The plan
# reports a "!" and exits 2 when the tenant disagrees; fix it in the dashboard. Leave one
# unset to skip its check. The custom domain has no entry of its own: it is the host in
# AUTH0_APP_AUTHORITY, which must be ready and the tenant's default custom domain.
# Needs read:tenant_settings, read:custom_domains and read:email_provider on the
# Management API app; a missing scope skips that check with a warning.
AUTH0_EXPECT_FRIENDLY_NAME="RV Intake"
AUTH0_EXPECT_EMAIL_PROVIDER=azure_cs
AUTH0_EXPECT_EMAIL_FROM=DoNotReply@mail.rvintake.com

# Baseline applications (baseline/clients/<name>.json) this tenant should have.
AUTH0_CLIENTS="rvs-blazor-manager swagger-spa-client"

# Every origin the Manager app is served from, across the environments this tenant
# serves: local dev, staging, production. Custom domains only: default SWA hostnames
# are left out, as they are in the API and storage CORS settings, so the app can't
# be used from them anyway.
AUTH0_MANAGER_ORIGINS="https://localhost:7300 https://manager-staging.rvintake.com https://manager.rvintake.com"

# Swagger UI OAuth2 login (local and staging API) and Postman.
AUTH0_SWAGGER_CALLBACKS="https://localhost:7116/swagger/oauth2-redirect.html https://api-staging.rvserviceflow.com/swagger/oauth2-redirect.html https://oauth.pstmn.io/v1/callback"
AUTH0_SWAGGER_LOGOUT_URLS="https://localhost:7116 https://api-staging.rvserviceflow.com/swagger"

# Manager appsettings files that must point at this tenant and client. The script
# checks them and reports mismatches; it never edits them.
AUTH0_MANAGER_CLIENT=rvs-blazor-manager
AUTH0_MANAGER_APPSETTINGS="RVS.Blazor.Manager/wwwroot/appsettings.Development.json RVS.Blazor.Manager/wwwroot/appsettings.Staging.json RVS.Blazor.Manager/wwwroot/appsettings.Production.json"
