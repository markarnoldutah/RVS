# Template for a per-environment Auth0 tenant. Copy to <name>.env, where <name>
# is what you pass to the scripts (e.g. dev, staging, prod).

# Must equal the file name without .env.
AUTH0_TENANT_NAME=

# Tenant domain without scheme or trailing slash, e.g. rvs-prod.us.auth0.com
AUTH0_DOMAIN=

# Key Vault holding this tenant's Management API M2M credentials, stored as
# ${AUTH0_MGMT_SECRET_PREFIX}--Domain, --ClientId and --ClientSecret.
AUTH0_MGMT_KEYVAULT=
AUTH0_MGMT_SECRET_PREFIX=Auth0Mgmt

# ── Used by auth0-apply.sh ──────────────────────────────────────────────────────

# API audience. RVS.API and the Manager app expect this value in every environment.
AUTH0_API_IDENTIFIER=https://api.rvserviceflow.com

# Baseline applications (baseline/clients/<name>.json) this tenant should have.
# Omit swagger-spa-client for a tenant with no Swagger UI login (e.g. prod).
AUTH0_CLIENTS="rvs-blazor-manager"

# Space-separated origins the Manager app is served from for this environment,
# e.g. "https://manager.rvserviceflow.com".
AUTH0_MANAGER_ORIGINS=

# Only needed when AUTH0_CLIENTS includes swagger-spa-client.
AUTH0_SWAGGER_CALLBACKS=
AUTH0_SWAGGER_LOGOUT_URLS=

# Manager appsettings files that should point at this tenant, e.g.
# "RVS.Blazor.Manager/wwwroot/appsettings.Production.json".
AUTH0_MANAGER_CLIENT=rvs-blazor-manager
AUTH0_MANAGER_APPSETTINGS=
