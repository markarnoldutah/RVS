# Template for a per-environment Auth0 tenant. Copy to <name>.env, where <name>
# is what you pass to the scripts (e.g. dev, staging, prod).

# Must equal the file name without .env.
AUTH0_TENANT_NAME=

# Tenant domain without scheme or trailing slash, e.g. rvs-prod.us.auth0.com
AUTH0_DOMAIN=

# Key Vault holding this tenant's Management API M2M credentials, stored as
# ${AUTH0_MGMT_SECRET_PREFIX}--Domain, --ClientId and --ClientSecret.
AUTH0_MGMT_KEYVAULT=
AUTH0_MGMT_SECRET_PREFIX=Auth0Mgmt

# ── Used by auth0-apply.sh ──────────────────────────────────────────────────────

# API audience. RVS.API and the Manager app expect this value in every environment.
AUTH0_API_IDENTIFIER=https://api.rvserviceflow.com

# The OIDC authority the BROWSER apps use. Leave unset while the tenant has no custom
# domain — it then defaults to https://$AUTH0_DOMAIN/. Once the Auth0 custom domain is
# live (Auth0 checklist §6) set it to https://login.rvintake.com/ and leave AUTH0_DOMAIN
# on the canonical .us.auth0.com host: that is where the Management API lives, and lib.sh
# fails the run if it disagrees with the vault's ${AUTH0_MGMT_SECRET_PREFIX}--Domain.
# auth0-apply.sh checks the Manager appsettings against THIS value, not AUTH0_DOMAIN.
#AUTH0_APP_AUTHORITY=https://login.rvintake.com/

# Tenant-wide settings set by hand in the dashboard (Auth0 checklist §6-§8). auth0-apply.sh
# checks them and never applies them; leave one unset to skip its check. The custom domain
# is checked through AUTH0_APP_AUTHORITY above, once that names one. Needs read:tenant_settings,
# read:custom_domains and read:email_provider on the Management API app.
#AUTH0_EXPECT_FRIENDLY_NAME="RV Intake"
#AUTH0_EXPECT_EMAIL_PROVIDER=azure_cs
#AUTH0_EXPECT_EMAIL_FROM=DoNotReply@mail.rvintake.com

# Universal Login branding and wording (checklist §7). Needs read:branding and read:prompts.
# AUTH0_EXPECT_LOGIN_DESCRIPTION must be single-quoted: ${clientName} is Auth0's placeholder
# for the application being logged in to, and this file is sourced by bash.
#AUTH0_EXPECT_BRANDING_LOGO_URL=https://manager.rvintake.com/icon-512.png
#AUTH0_EXPECT_BRANDING_FAVICON_URL=https://manager.rvintake.com/favicon-32x32.png
#AUTH0_EXPECT_BRANDING_PRIMARY_COLOR="#C1502E"
#AUTH0_EXPECT_BRANDING_PAGE_BACKGROUND="#FAF8F3"
#AUTH0_EXPECT_LOGIN_DESCRIPTION='Log in to ${clientName}'
#AUTH0_EXPECT_LOGIN_PROMPTS="login login-id login-password"

# Baseline applications (baseline/clients/<name>.json) this tenant should have.
# Omit swagger-spa-client for a tenant with no Swagger UI login (e.g. prod).
AUTH0_CLIENTS="rvs-blazor-manager"

# Space-separated origins the Manager app is served from for this environment,
# e.g. "https://manager.rvintake.com".
AUTH0_MANAGER_ORIGINS=

# Only needed when AUTH0_CLIENTS includes swagger-spa-client.
AUTH0_SWAGGER_CALLBACKS=
AUTH0_SWAGGER_LOGOUT_URLS=

# Manager appsettings files that should point at this tenant, e.g.
# "RVS.Blazor.Manager/wwwroot/appsettings.Production.json".
AUTH0_MANAGER_CLIENT=rvs-blazor-manager
AUTH0_MANAGER_APPSETTINGS=
